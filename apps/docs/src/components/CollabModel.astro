---
import HiveMark from "../assets/hive-mark.svg";
import { getSiteConfig, withBase } from "../../scripts/site-config.mjs";
import type { AgentKind, Scene } from "./collab-scenes";

interface Props {
  scene: Scene;
}

const { scene } = Astro.props;
const { id, machines, steps, feed, board, ask, layout, devices = [] } = scene;
const { base } = getSiteConfig();
const last = steps.length - 1;

const marks: Record<AgentKind, string> = {
  claude: "M12 2v20M2 12h20M5 5l14 14M5 19 19 5",
  codex: "m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18",
  omp: "M3 4h18v16H3V4Zm4 4 3 4-3 4m6 0h4",
  opencode: "M3 4h8v16H3V4Zm10 0h8v16h-8V4ZM7 8v8m10-8v8",
  copilot: "M4 14a8 8 0 0 1 16 0v3a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-3Zm5-1v2m6-2v2",
};
const deviceMarks = {
  phone:
    "M8 2.5h8a1.5 1.5 0 0 1 1.5 1.5v16a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20V4A1.5 1.5 0 0 1 8 2.5Zm3 16h2",
  desktop: "M3.5 4.5h17v11h-17v-11ZM9 20h6m-3-4.5V20",
};

// orbit：房间居中，第一台电脑的 Agent 排在上半圈、第二台排在下半圈（和样式里的环一致）
const ORBIT = { cx: 60, cy: 50, rx: 31, ry: 41 };
const orbitPosition = (group: number, index: number, count: number) => {
  const t = count === 1 ? 0.5 : index / (count - 1);
  const degrees = group === 0 ? -145 + t * 110 : 145 - t * 110;
  const angle = (degrees * Math.PI) / 180;
  const x = ORBIT.cx + ORBIT.rx * Math.cos(angle);
  const y = ORBIT.cy + ORBIT.ry * Math.sin(angle);
  return `--x: ${x.toFixed(2)}%; --y: ${y.toFixed(2)}%`;
};
const lock = "M5.5 7V5a2.5 2.5 0 0 1 5 0v2";
---

<figure
  class="cm not-content"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-desc`}
  data-steps={JSON.stringify(steps.map(({ links, status }) => ({ links, status })))}
>
  <div class="cm-frame">
    <div class="cm-head">
      <p class="cm-kicker" id={`${id}-title`}>
        <span class="cm-tag">{scene.tag}</span>
        <span>{scene.title}</span>
      </p>
      <span class="cm-head-side">
        <span class="cm-badge">示意图</span>
        <button type="button" class="cm-toggle" data-cm-toggle aria-pressed="false" hidden>
          <svg class="cm-icon-pause" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.5v9M11 3.5v9"></path>
          </svg>
          <svg class="cm-icon-play" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.2v9.6L12.5 8 5 3.2Z"></path>
          </svg>
          <span data-cm-toggle-label>暂停</span>
        </button>
      </span>
    </div>
    <p class="cm-sr" id={`${id}-desc`}>{scene.description}</p>

    <div class:list={["cm-stage", `cm-${layout}`]} aria-hidden="true">
      <svg class="cm-wires" data-cm-wires></svg>

      {
        layout === "orbit" ? (
          <>
            <div class="cm-person">
              <div class="cm-person-head">
                <span class="cm-node-icon">你</span>
                <span class="cm-node-text">
                  <strong>你一个人</strong>
                  <span>手机、电脑都能指挥</span>
                </span>
              </div>
              <ul class="cm-devices">
                {devices.map((device) => (
                  <li class="cm-node cm-node-device" data-node={device.node}>
                    <span class="cm-node-icon">
                      <svg viewBox="0 0 24 24">
                        <path d={deviceMarks[device.kind]} />
                      </svg>
                    </span>
                    <span class="cm-node-text">
                      <strong>{device.name}</strong>
                      <span>{device.role}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            {machines.map((machine, group) => (
              <div class:list={["cm-orbit-group", `cm-orbit-group-${group}`]}>
                <span class="cm-ring" />
                <span class="cm-orbit-label">
                  <strong>{machine.label}</strong>
                  <span class="cm-local">
                    <svg viewBox="0 0 16 16">
                      <rect x="3" y="7" width="10" height="7" rx="1.5" />
                      <path d={lock} />
                    </svg>
                    留在本机
                  </span>
                </span>
                <ul class="cm-orbit-nodes">
                  {machine.nodes.map((node, index) => (
                    <li
                      class="cm-node cm-node-agent"
                      data-node={node.node}
                      style={orbitPosition(group, index, machine.nodes.length)}
                    >
                      <span class="cm-node-icon">
                        <svg viewBox="0 0 24 24">
                          <path d={marks[node.kind as AgentKind]} />
                        </svg>
                      </span>
                      <span class="cm-node-text">
                        <strong>{node.name}</strong>
                        <span>{node.role}</span>
                      </span>
                      <span class="cm-status" data-cm-status />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </>
        ) : (
          <div class="cm-machines">
            {machines.map((machine, index) => (
              <div
                class:list={["cm-machine", { "cm-machine-you": index === 0 }]}
                style={`--cm-count: ${machine.nodes.length}`}
              >
                <div class="cm-machine-head">
                  <strong>{machine.label}</strong>
                  <span class="cm-local">
                    <svg viewBox="0 0 16 16">
                      <rect x="3" y="7" width="10" height="7" rx="1.5" />
                      <path d={lock} />
                    </svg>
                    <span class="cm-local-long">文件 · 权限 · 会话留在本机</span>
                    <span class="cm-local-short">留在本机</span>
                  </span>
                </div>
                <ul class="cm-nodes">
                  {machine.nodes.map((node) => (
                    <li
                      class:list={[
                        "cm-node",
                        `cm-node-${node.kind === "human" ? "human" : "agent"}`,
                      ]}
                      data-node={node.node}
                    >
                      <span class="cm-node-icon">
                        {node.kind === "human" ? (
                          node.name.slice(0, 1)
                        ) : (
                          <svg viewBox="0 0 24 24">
                            <path d={marks[node.kind as AgentKind]} />
                          </svg>
                        )}
                      </span>
                      <span class="cm-node-text">
                        <strong>{node.name}</strong>
                        <span>{node.role}</span>
                      </span>
                      {node.kind !== "human" && <span class="cm-status" data-cm-status />}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }

      <div class="cm-room" data-cm-room>
        <div class="cm-room-head">
          <HiveMark width={26} height={26} />
          <span class="cm-room-name">
            <strong>{scene.room}</strong>
            <span>同一个 SuperHive 房间</span>
          </span>
          <span class="cm-room-note">只走公开消息</span>
        </div>
        <div class="cm-zones">
          <div class="cm-zone cm-zone-msg">
            <span class="cm-zone-title">公开消息</span>
            <div class="cm-feed">
              {
                feed.map((item) => (
                  <p class="cm-line" data-at={item.at} data-on={item.at}>
                    <b>{item.who}</b> {item.text}
                  </p>
                ))
              }
            </div>
          </div>
          <div class="cm-zone cm-zone-board">
            <span class="cm-zone-title">协作白板</span>
            {
              board.map((item) => (
                <p class="cm-line" data-at={item.at} data-on={item.on}>
                  {item.text}
                  <span class:list={["cm-pill", { "cm-pill-ok": item.ok }]}>{item.pill}</span>
                </p>
              ))
            }
          </div>
          <div class="cm-zone cm-zone-ask">
            <span class="cm-zone-title">等你回答</span>
            <p class="cm-line" data-on={ask.on}>{ask.question}</p>
            <span class="cm-options">
              <span class="cm-option cm-option-pick" data-on={ask.pickedOn}>{ask.pick}</span>
              <span class="cm-option">{ask.other}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <ol class="cm-steps">
      {
        steps.map((step, index) => (
          <li>
            <button
              type="button"
              class="cm-step"
              data-go={index}
              aria-current={index === last ? "step" : undefined}
            >
              <span class="cm-step-dot" aria-hidden="true">
                {index + 1}
              </span>
              <span class="cm-step-text">
                <strong>{step.title}</strong>
                <span>{step.detail}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <figcaption>
    <span>示意图，人名、Agent 名和任务均为演示数据。</span>
    <a href={withBase("guides/collaboration/", base)}>
      了解委派、进展与提问 <span aria-hidden="true">→</span>
    </a>
  </figcaption>
</figure>

<script>
  import type { Scene, Status } from "./collab-scenes";

  type Step = Pick<Scene["steps"][number], "links" | "status">;

  const STEP_MS = 4000;
  const SVG = "http://www.w3.org/2000/svg";
  const LABELS: Record<Status, string> = {
    run: "执行中",
    wait: "等结果",
    ask: "等你回答",
    done: "已交回",
  };
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  // 和样式里的窄屏断点一致：窄屏时房间在左、电脑竖排在右
  const narrow = window.matchMedia("(max-width: 56rem)");
  // orbit 放不下一圈时的断点，和样式一致：Agent 竖排在右，线从卡片左侧横着进房间
  const stacked = window.matchMedia("(max-width: 72rem)");

  for (const figure of document.querySelectorAll<HTMLElement>(".cm")) {
    const steps: Step[] = JSON.parse(figure.dataset.steps!);
    const stage = figure.querySelector<HTMLElement>(".cm-stage")!;
    const svg = figure.querySelector<SVGSVGElement>("[data-cm-wires]")!;
    const room = figure.querySelector<HTMLElement>("[data-cm-room]")!;
    const nodes = [...figure.querySelectorAll<HTMLElement>("[data-node]")];
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const highlights = [...figure.querySelectorAll<HTMLElement>("[data-on]")];
    const timed = [...figure.querySelectorAll<HTMLElement>("[data-at]")];
    const toggle = figure.querySelector<HTMLButtonElement>("[data-cm-toggle]");
    const toggleLabel = figure.querySelector<HTMLElement>("[data-cm-toggle-label]");
    const last = steps.length - 1;
    const wires = new Map<string, SVGElement>();
    let step = last;
    let timer = 0;
    let paused = reduce.matches;
    let visible = false;

    const centerOf = (rect: DOMRect, box: DOMRect): [number, number] => [
      rect.left + rect.width / 2 - box.left,
      rect.top + rect.height / 2 - box.top,
    ];
    // 从矩形中心朝 target 走，落在矩形边上的那一点
    const edgeToward = (
      rect: DOMRect,
      box: DOMRect,
      target: [number, number],
    ): [number, number] => {
      const [cx, cy] = centerOf(rect, box);
      const [dx, dy] = [target[0] - cx, target[1] - cy];
      const t = Math.min(
        rect.width / 2 / (Math.abs(dx) || 1e-6),
        rect.height / 2 / (Math.abs(dy) || 1e-6),
      );
      return [cx + dx * t, cy + dy * t];
    };

    const make = (name: string, attrs: Record<string, string | number>) => {
      const el = document.createElementNS(SVG, name);
      for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));
      return el;
    };

    // 每个人、每个 Agent 从自己的连接口拉一条曲线进房间；入口按顺序排开，线不互相打结
    const orbit = stage.classList.contains("cm-orbit");
    const draw = () => {
      const box = stage.getBoundingClientRect();
      const roomBox = room.getBoundingClientRect();
      const roomCenter = centerOf(roomBox, box);
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      svg.replaceChildren();
      wires.clear();
      // 横着进房间的那些线按顺序分配入口
      const lined = nodes.filter((node) => !orbit || !node.classList.contains("cm-node-device"));
      const count = lined.length;
      nodes.forEach((node, index) => {
        const rect = node.getBoundingClientRect();
        const order = lined.indexOf(node);
        const t = count === 1 ? 0.5 : order / (count - 1);
        let d: string;
        let port: [number, number];
        let inlet: [number, number];
        if (orbit && !(stacked.matches && order >= 0)) {
          // 环形：从卡片朝房间的那条边出发，到房间朝卡片的那条边；中段往一侧偏，汇进房间时带点旋涡感
          port = edgeToward(rect, box, roomCenter);
          inlet = edgeToward(roomBox, box, centerOf(rect, box));
          const [vx, vy] = [inlet[0] - port[0], inlet[1] - port[1]];
          const length = Math.hypot(vx, vy) || 1;
          const [nx, ny] = [(-vy / length) * length * 0.22, (vx / length) * length * 0.22];
          d = `M${port[0]} ${port[1]}C${port[0] + vx * 0.3 + nx} ${port[1] + vy * 0.3 + ny} ${port[0] + vx * 0.75 + nx * 0.5} ${port[1] + vy * 0.75 + ny * 0.5} ${inlet[0]} ${inlet[1]}`;
        } else if (narrow.matches || orbit) {
          port = [rect.left - box.left, rect.top + rect.height / 2 - box.top];
          inlet = [
            roomBox.right - box.left,
            roomBox.top - box.top + roomBox.height * (0.08 + t * 0.84),
          ];
          const k = (port[0] - inlet[0]) * 0.7;
          d = `M${port[0]} ${port[1]}C${port[0] - k} ${port[1]} ${inlet[0] + k} ${inlet[1]} ${inlet[0]} ${inlet[1]}`;
        } else {
          port = [rect.left + rect.width / 2 - box.left, rect.bottom - box.top];
          inlet = [
            roomBox.left - box.left + roomBox.width * (0.26 + t * 0.48),
            roomBox.top - box.top,
          ];
          const k = (inlet[1] - port[1]) * 0.75;
          d = `M${port[0]} ${port[1]}C${port[0]} ${port[1] + k} ${inlet[0]} ${inlet[1] - k} ${inlet[0]} ${inlet[1]}`;
        }
        const group = make("g", { class: "cm-wire", style: `--cm-delay: ${index * -0.47}s` });
        group.append(
          make("path", { class: "cm-wire-base", d }),
          make("path", { class: "cm-wire-flow", d, pathLength: 100 }),
          make("path", { class: "cm-wire-flow cm-wire-back", d, pathLength: 100 }),
          make("path", { class: "cm-wire-hot", d }),
          make("path", { class: "cm-wire-pulse cm-wire-glow", d, pathLength: 100 }),
          make("path", { class: "cm-wire-pulse", d, pathLength: 100 }),
          make("circle", { class: "cm-port", cx: port[0], cy: port[1], r: 3 }),
          make("circle", { class: "cm-port", cx: inlet[0], cy: inlet[1], r: 2.5 }),
        );
        svg.append(group);
        wires.set(node.dataset.node!, group);
      });
      mark();
    };

    // 按当前步骤挂状态：发起方、接收方、累积到这一步的 Agent 状态、房间里出现和亮起的内容
    const mark = () => {
      const live = figure.classList.contains("is-live");
      const from = new Set(steps[step].links.map((link) => link.from));
      const to = new Set(steps[step].links.flatMap((link) => link.to));
      const status: Record<string, Status> = {};
      for (const past of steps.slice(0, step + 1)) Object.assign(status, past.status);
      for (const node of nodes) {
        const name = node.dataset.node!;
        node.classList.toggle("is-from", live && from.has(name));
        node.classList.toggle("is-to", live && to.has(name));
        const badge = node.querySelector<HTMLElement>("[data-cm-status]");
        if (badge) {
          const value = live ? status[name] : undefined;
          badge.textContent = value ? LABELS[value] : "";
          if (value) badge.dataset.kind = value;
          else delete badge.dataset.kind;
        }
      }
      for (const [name, wire] of wires) {
        wire.classList.toggle("is-from", live && from.has(name));
        wire.classList.toggle("is-to", live && to.has(name));
      }
      for (const item of highlights) {
        item.classList.toggle("is-on", live && item.dataset.on!.split(" ").includes(String(step)));
      }
      for (const item of timed) {
        item.classList.toggle("is-later", live && Number(item.dataset.at) > step);
      }
      figure.classList.remove("is-run");
      void figure.offsetWidth;
      figure.classList.toggle("is-run", live && !paused);
    };

    const show = (next: number) => {
      step = next;
      buttons.forEach((button, index) => {
        if (index === step) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
      });
      mark();
    };

    const schedule = () => {
      clearTimeout(timer);
      figure.classList.toggle("is-idle", paused || !visible || document.hidden);
      if (paused || !visible || document.hidden) return;
      timer = window.setTimeout(
        () => {
          show(step === last ? 0 : step + 1);
          schedule();
        },
        STEP_MS + (step === last ? 1500 : 0),
      );
    };

    const setPaused = (value: boolean) => {
      paused = value;
      figure.classList.toggle("is-paused", paused);
      if (toggle && toggleLabel) {
        toggle.setAttribute("aria-pressed", String(paused));
        toggleLabel.textContent = paused ? "播放" : "暂停";
      }
      schedule();
    };

    buttons.forEach((button, index) =>
      button.addEventListener("click", () => {
        setPaused(true);
        show(index);
      }),
    );
    toggle?.addEventListener("click", () => {
      setPaused(!paused);
      if (!paused) show(step === last ? 0 : step + 1);
    });

    new ResizeObserver(draw).observe(stage);
    narrow.addEventListener("change", draw);
    stacked.addEventListener("change", draw);
    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      // 重新进入视野时从第一步讲起
      if (visible && !wasVisible && !paused) show(0);
      schedule();
    }).observe(figure);
    document.addEventListener("visibilitychange", schedule);

    // 减少动态效果时不启动轮播，保留完整的静态图
    if (!reduce.matches) {
      if (toggle) toggle.hidden = false;
      figure.classList.add("is-live");
    }
    draw();
  }
</script>

<style>
  .cm {
    --cm-ok: #1f8a5b;
    --cm-warn: #b86e00;
    --cm-line: var(--sl-color-gray-5);
    --cm-panel: var(--sl-color-bg-sidebar);
    --cm-surface: var(--sl-color-bg);
    --cm-raised: var(--sl-color-gray-6);
    --cm-wire: var(--sl-color-gray-4);
    --cm-ms: 4000ms;
    --cm-width: min(calc(100vw - 2 * clamp(1.5rem, 4vw, 5rem)), 110rem);
    min-width: 0;
    margin: 0;
  }

  :global(:root:not([data-theme="light"])) .cm {
    --cm-ok: #4cc38a;
    --cm-warn: #f0b252;
    --cm-panel: #181818;
    --cm-surface: #1d1d1d;
    --cm-raised: #2a2a2a;
  }

  /* 桌面上占满屏幕宽度，超宽屏封顶，免得线拉得太稀 */
  @media (min-width: 56.01rem) {
    .cm {
      width: var(--cm-width);
      margin-inline: calc(50% - var(--cm-width) / 2);
    }
  }

  .cm-frame {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--cm-line);
    border-radius: 1.25rem;
    background: var(--cm-panel);
    color: var(--sl-color-white);
    line-height: 1.5;
    text-align: left;
  }

  .cm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .cm-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cm-tag {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .cm-head-side {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .cm-badge {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--cm-line);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
  }

  .cm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cm-stage {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    row-gap: 8rem;
  }

  .cm-stage svg:not(.cm-wires) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 电脑：每台一个虚线框，宽度按里面的人数和 Agent 数分配 */
  .cm-machines {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.9rem;
  }

  .cm-machine {
    flex: var(--cm-count) 1 0;
    container-type: inline-size;
    min-width: 0;
    padding: 0.6rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.9rem;
  }

  .cm-machine-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0.15rem 0.5rem;
  }

  .cm-machine-head strong {
    font-size: 0.78rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .cm-local {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .cm-local svg {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    stroke-width: 1.5;
  }

  .cm-local-short {
    display: none;
  }

  /* 电脑框太窄时只写「留在本机」 */
  @container (max-width: 19rem) {
    .cm-local-long {
      display: none;
    }

    .cm-local-short {
      display: inline;
    }
  }

  .cm-nodes {
    display: grid;
    grid-template-columns: repeat(var(--cm-count), minmax(0, 1fr));
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cm-node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    margin: 0;
    padding: 0.55rem 0.3rem 0.6rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.65rem;
    background: var(--cm-surface);
    text-align: center;
    transition:
      border-color 250ms ease,
      background-color 250ms ease;
  }

  .cm-node-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.5rem;
    background: var(--cm-raised);
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .cm-node-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .cm-node-human .cm-node-icon {
    border-radius: 50%;
    color: var(--sl-color-gray-2);
  }

  .cm-machine-you .cm-node-human .cm-node-icon {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .cm-node-text {
    display: grid;
    width: 100%;
    min-width: 0;
  }

  .cm-node-text strong,
  .cm-node-text span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-node-text strong {
    font-size: 0.74rem;
    font-weight: 600;
  }

  /* Agent 名放不下时在连字符处折行，不截断 */
  .cm-node-agent .cm-node-text strong {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .cm-node-text span {
    color: var(--sl-color-gray-3);
    font-size: 0.62rem;
  }

  .cm-node.is-from,
  .cm-node.is-to {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* Agent 卡片右上角的轻量状态：执行中 / 等结果 / 等你回答 / 已交回 */
  .cm-status {
    position: absolute;
    top: -0.55rem;
    right: 0.35rem;
    display: none;
    padding: 0 0.35rem;
    border: 1px solid var(--cm-line);
    border-radius: 999px;
    background: var(--cm-surface);
    color: var(--sl-color-gray-2);
    font-size: 0.58rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }

  .cm-status[data-kind] {
    display: block;
  }

  .cm-status[data-kind="run"] {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--cm-line));
    color: var(--sl-color-accent-high);
  }

  .cm-status[data-kind="ask"] {
    border-color: color-mix(in srgb, var(--cm-warn) 55%, var(--cm-line));
    color: var(--cm-warn);
  }

  .cm-status[data-kind="done"] {
    border-color: color-mix(in srgb, var(--cm-ok) 45%, var(--cm-line));
    color: var(--cm-ok);
  }

  /* 连线：底线 + 常驻的暗淡流动；当前这一步的路径整条点亮，光点走完 */
  .cm-wires {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
  }

  .cm-wires :global(.cm-wire-base) {
    stroke: var(--cm-wire);
    stroke-width: 1;
    opacity: 0.7;
  }

  .cm-wires :global(.cm-port) {
    fill: var(--cm-wire);
    stroke: var(--cm-panel);
    stroke-width: 1.5;
  }

  .cm-wires :global(.cm-wire-flow),
  .cm-wires :global(.cm-wire-hot),
  .cm-wires :global(.cm-wire-pulse) {
    opacity: 0;
  }

  .cm-wires :global(.cm-wire-hot) {
    stroke: var(--sl-color-accent);
    stroke-width: 1.75;
  }

  .cm-wires :global(:is(.is-from, .is-to) .cm-wire-hot) {
    opacity: 1;
  }

  .cm-wires :global(:is(.is-from, .is-to) .cm-port) {
    fill: var(--sl-color-accent);
  }

  .cm-wires :global(.cm-wire-pulse) {
    stroke: var(--sl-color-accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 5 200;
    stroke-dashoffset: 5;
  }

  .cm-wires :global(.cm-wire-glow) {
    stroke-width: 12;
    stroke-dasharray: 9 200;
  }

  /* 房间 */
  .cm-room {
    position: relative;
    z-index: 1;
    padding: 0.9rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.9rem;
    background: var(--cm-surface);
    box-shadow: 0 12px 40px -24px rgb(0 0 0 / 0.35);
  }

  .cm-room-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cm-room-head > svg {
    flex-shrink: 0;
  }

  .cm-room-name {
    display: grid;
    min-width: 0;
  }

  .cm-room-name strong {
    font-size: 0.88rem;
    font-weight: 650;
  }

  .cm-room-name span {
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
  }

  .cm-room-note {
    margin-left: auto;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .cm-zones {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .cm-zone {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.6rem;
    background: var(--cm-panel);
  }

  .cm-zone-title {
    margin-bottom: 0.1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* 消息区只露出最近四条，新消息从底部进来 */
  .cm-feed {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    overflow: hidden;
  }

  .cm.is-live .cm-feed {
    height: 6.6rem;
    mask-image: linear-gradient(to bottom, transparent 0, #000 1.2rem);
  }

  .cm-line {
    flex-shrink: 0;
    margin: 0 -0.35rem;
    padding: 0.1rem 0.35rem;
    overflow: hidden;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.74rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .cm-line b {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .cm-line.is-on {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }

  .cm-line.is-later {
    display: none;
  }

  .cm-pill {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.64rem;
    font-weight: 600;
  }

  .cm-pill-ok {
    background: color-mix(in srgb, var(--cm-ok) 16%, transparent);
    color: var(--cm-ok);
  }

  .cm-zone-ask {
    border-color: color-mix(in srgb, var(--cm-warn) 45%, var(--cm-line));
  }

  .cm-zone-ask .cm-zone-title {
    color: var(--cm-warn);
  }

  .cm-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .cm-option {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.4rem;
    background: var(--cm-surface);
    font-size: 0.66rem;
    white-space: nowrap;
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .cm:not(.is-live) .cm-option-pick,
  .cm-option-pick.is-on {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  /* 下方的步骤 */
  .cm-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cm-steps li {
    display: flex;
    margin: 0;
  }

  .cm-step {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    padding: 0.6rem;
    border: 0;
    border-radius: 0.7rem;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 250ms ease,
      box-shadow 250ms ease;
  }

  .cm-step:hover {
    background: var(--cm-raised);
  }

  .cm-step-dot {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      color 250ms ease;
  }

  .cm-step-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .cm-step-text strong {
    color: var(--sl-color-white);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cm-step-text span {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .cm.is-live .cm-step[aria-current] {
    background: var(--cm-surface);
    box-shadow: inset 0 0 0 1px var(--cm-line);
  }

  .cm.is-live .cm-step[aria-current] .cm-step-dot {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .cm-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem 0.25rem 0.45rem;
    border: 1px solid var(--cm-line);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .cm-toggle[hidden] {
    display: none;
  }

  .cm-toggle:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .cm-toggle svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cm-icon-play,
  .cm.is-paused .cm-icon-pause {
    display: none;
  }

  .cm.is-paused .cm-icon-play {
    display: block;
    fill: currentColor;
  }

  /*
   * orbit：房间在正中，Agent 沿一圈环绕（上半圈一台电脑、下半圈另一台），
   * 左边是一个人和他手里的入口。圆心和半径与 frontmatter 里的 ORBIT 一致。
   */
  .cm-orbit {
    --cm-cx: 60%;
    --cm-cy: 50%;
    --cm-rx: 31%;
    --cm-ry: 41%;
    display: block;
    height: 40rem;
  }

  .cm-orbit .cm-node {
    flex-direction: row;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    text-align: left;
  }

  .cm-orbit .cm-node-text span {
    display: block;
  }

  .cm-person {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 1;
    width: 12.5rem;
    padding: 0.75rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.9rem;
    translate: 0 -50%;
  }

  .cm-person-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.65rem;
  }

  .cm-person-head .cm-node-icon {
    border-radius: 50%;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .cm-person-head strong {
    font-size: 0.85rem;
  }

  .cm-devices {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cm-node-device .cm-node-icon {
    color: var(--sl-color-gray-2);
  }

  .cm-orbit-group,
  .cm-orbit-nodes {
    display: contents;
  }

  .cm-ring {
    position: absolute;
    top: calc(var(--cm-cy) - var(--cm-ry));
    left: calc(var(--cm-cx) - var(--cm-rx));
    width: calc(var(--cm-rx) * 2);
    height: calc(var(--cm-ry) * 2);
    border: 1px dashed var(--sl-color-gray-5);
    border-radius: 50%;
    pointer-events: none;
  }

  .cm-orbit-group-0 .cm-ring {
    clip-path: inset(0 0 50.5% 0);
  }

  .cm-orbit-group-1 .cm-ring {
    clip-path: inset(50.5% 0 0 0);
  }

  .cm-orbit-label {
    position: absolute;
    left: calc(var(--cm-cx) + var(--cm-rx) - 0.5rem);
    z-index: 1;
    display: grid;
    gap: 0.1rem;
    font-size: 0.74rem;
  }

  .cm-orbit-group-0 .cm-orbit-label {
    top: calc(var(--cm-cy) - 4.2rem);
  }

  .cm-orbit-group-1 .cm-orbit-label {
    top: calc(var(--cm-cy) + 1.4rem);
  }

  .cm-orbit .cm-node-agent {
    position: absolute;
    top: var(--y);
    left: var(--x);
    z-index: 1;
    width: 9.5rem;
    translate: -50% -50%;
  }

  .cm-orbit .cm-room {
    position: absolute;
    top: var(--cm-cy);
    left: var(--cm-cx);
    width: min(25rem, 30%);
    translate: -50% -50%;
  }

  .cm-orbit .cm-zones {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .cm-orbit .cm-zone-msg {
    grid-column: 1 / -1;
  }

  .cm.is-live .cm-orbit .cm-feed {
    height: 4.8rem;
  }

  /* 放不下一圈时：左边是人和房间，右边按电脑列出 Agent */
  @media (max-width: 72rem) {
    .cm-orbit {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 2.75rem minmax(0, 1.05fr);
      grid-template-rows: auto auto;
      row-gap: 1.25rem;
      height: auto;
    }

    .cm-orbit .cm-person {
      position: static;
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      width: auto;
      translate: none;
    }

    .cm-orbit .cm-room {
      position: static;
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      width: auto;
      translate: none;
    }

    .cm-orbit-group {
      display: block;
      grid-column: 3;
      align-self: start;
      padding: 0.45rem;
      border: 1px dashed var(--sl-color-gray-4);
      border-radius: 0.75rem;
    }

    .cm-orbit-group-0 {
      grid-row: 1;
    }

    .cm-orbit-group-1 {
      grid-row: 2;
    }

    .cm-ring {
      display: none;
    }

    .cm-orbit .cm-orbit-label {
      position: static;
      margin: 0 0.15rem 0.4rem;
    }

    .cm-orbit-nodes {
      display: grid;
      gap: 0.3rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .cm-orbit .cm-node-agent {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      translate: none;
    }

    .cm-orbit .cm-zones {
      grid-template-columns: minmax(0, 1fr);
    }

    .cm.is-live .cm-orbit .cm-feed {
      height: 9rem;
    }
  }

  @media (max-width: 40rem) {
    .cm-orbit .cm-node {
      gap: 0.4rem;
      padding: 0.3rem 0.4rem;
    }

    .cm-orbit .cm-node-text span {
      display: none;
    }

    .cm-orbit .cm-status {
      position: static;
      flex-shrink: 0;
      margin-left: auto;
    }
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    line-height: 1.7;
  }

  figcaption a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  figcaption a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 80rem) {
    .cm-node-text span {
      display: none;
    }
  }

  /* 窄屏：房间在左，各台电脑竖排在右，线从卡片左侧横着弯进房间 */
  @media (max-width: 56rem) {
    .cm-frame {
      padding: 0.8rem;
      border-radius: 1rem;
    }

    .cm-head {
      align-items: flex-start;
    }

    .cm-stage {
      grid-template-columns: minmax(0, 1fr) 2.75rem minmax(0, 1.05fr);
      grid-template-rows: auto;
      row-gap: 0;
    }

    .cm-machines {
      flex-direction: column;
      grid-column: 3;
      grid-row: 1;
      gap: 0.6rem;
    }

    .cm-machine {
      flex: none;
      padding: 0.45rem;
      border-radius: 0.75rem;
    }

    .cm-machine-head {
      flex-direction: column;
      gap: 0;
      margin-bottom: 0.35rem;
    }

    .cm-nodes {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }

    .cm-node {
      flex-direction: row;
      gap: 0.4rem;
      padding: 0.3rem 0.4rem;
      border-radius: 0.5rem;
      text-align: left;
    }

    .cm-node-icon {
      width: 1.35rem;
      height: 1.35rem;
      font-size: 0.64rem;
    }

    .cm-node-icon svg {
      width: 0.8rem;
      height: 0.8rem;
    }

    .cm-node-agent .cm-node-text strong {
      font-size: 0.62rem;
    }

    .cm-status {
      position: static;
      flex-shrink: 0;
      margin-left: auto;
    }

    .cm-room {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      padding: 0.6rem;
    }

    .cm-room-head {
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .cm-room-head > svg {
      width: 1.3rem;
      height: 1.3rem;
    }

    .cm-room-note {
      margin-left: 0;
    }

    .cm-zones {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.45rem;
    }

    .cm-zone {
      padding: 0.45rem 0.5rem;
    }

    .cm.is-live .cm-feed {
      height: 12.5rem;
    }

    .cm-line {
      font-size: 0.66rem;
      white-space: normal;
    }

    .cm-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }

    .cm-step {
      flex-direction: row;
      gap: 0.65rem;
      padding: 0.5rem;
    }
  }

  @media (max-width: 30rem) {
    .cm-node-agent .cm-node-icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cm.is-live .cm-wires :global(.cm-wire-flow) {
      stroke: var(--sl-color-accent);
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-dasharray: 3 97;
      opacity: 0.4;
      animation: cm-flow 5.6s linear infinite;
      animation-delay: var(--cm-delay, 0s);
    }

    .cm.is-live .cm-wires :global(.cm-wire-back) {
      stroke-width: 1.75;
      stroke-dasharray: 2 98;
      animation-name: cm-flow-back;
      animation-delay: calc(var(--cm-delay, 0s) - 2.8s);
    }

    .cm.is-live .cm-wires :global(:is(.is-from, .is-to) .cm-wire-flow) {
      opacity: 0;
    }

    .cm.is-run .cm-wires :global(.is-from .cm-wire-pulse) {
      animation: cm-go var(--cm-ms) linear both;
    }

    .cm.is-run .cm-wires :global(.is-to .cm-wire-pulse) {
      animation: cm-come var(--cm-ms) linear both;
    }

