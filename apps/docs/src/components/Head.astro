---
import ImageZoom from "./ImageZoom.astro";
import { localePath, pageLang, ui } from "./i18n";
import { getSiteConfig, withBase } from "../../scripts/site-config.mjs";
import { projectLinks, repoUrl } from "../../scripts/project-links.mjs";

const { site, base, indexable } = getSiteConfig();
const route = Astro.locals.starlightRoute;
const lang = pageLang(Astro.locals);
const text = ui[lang];
// 英文页的 id 带 en/ 前缀，去掉后两种语言同一页的 id 相同；首页是空字符串
const pageId = route.id.replace(/^en(?:\/|$)/, "");
const is404 = pageId === "404";
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL(withBase("social-card.png", base), site).href;
const home = new URL(localePath("", lang, base), site).href;
// 两种语言都有，x-default 指向中文（根语言）
const xDefault = new URL(withBase(pageId ? `${pageId}/` : "", base), site).href;
const groups: Record<string, string> = text.groups;
const group = pageId.split("/")[0];
const breadcrumbs = [
  { "@type": "ListItem", position: 1, name: text.siteName, item: home },
  ...(pageId
    ? [{ "@type": "ListItem", position: 2, name: route.entry.data.title, item: canonical }]
    : []),
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: text.siteName,
      url: home,
      inLanguage: lang,
    },
    {
      "@type": pageId ? "TechArticle" : "WebPage",
      "@id": `${canonical}#page`,
      headline: route.entry.data.title,
      description: route.entry.data.description,
      url: canonical,
      inLanguage: lang,
      isPartOf: { "@id": `${home}#website` },
      ...(group && groups[group] ? { articleSection: groups[group] } : {}),
    },
    { "@type": "BreadcrumbList", itemListElement: breadcrumbs },
    // 首页额外说明 SuperHive 这个软件本身：免费、开源，附源码和 npm 地址
    ...(pageId
      ? []
      : [
          {
            "@type": "SoftwareApplication",
            "@id": `${home}#software`,
            name: "SuperHive",
            description: route.entry.data.description,
            applicationCategory: "DeveloperApplication",
            operatingSystem: "macOS, Linux, Windows",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
            license: projectLinks.find((link) => link.href.endsWith("/LICENSE"))?.href,
            url: home,
            codeRepository: repoUrl,
            sameAs: [repoUrl, projectLinks.find((link) => link.href.includes("npmjs.com"))?.href],
          },
        ]),
  ],
};
---

{
  route.head
    // 404 页不需要语言对应关系
    .filter(({ attrs }) => !(is404 && attrs?.rel === "alternate"))
    .map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)
}
<script is:inline define:vars={{ base, is404 }}>
  // 只在中文首页自动跳：还没手动选过语言、浏览器语言不是中文时，换到英文首页；选过英文的也换过去。
  // 用户打开的具体页面（正文页、英文首页）一律不跳，尊重链接本身的语言，正文页改为显示一条可关闭的提示。
  // 在 head 里同步执行，跳转发生在正文绘制之前，不会先闪一下中文。爬虫和测速工具不跳；站内点链接回首页的也不跳。
  (() => {
    try {
      if (
        /bot|crawl|spider|slurp|lighthouse|headless|preview|facebookexternalhit/i.test(
          navigator.userAgent,
        )
      )
        return;
      const path = location.pathname;
      if (!path.startsWith(base)) return;
      const rest = path.slice(base.length);
      let want = null;
      try {
        want = localStorage.getItem("superhive.docs.locale");
      } catch {}
      const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
      const chineseBrowser = languages.some((language) => /^zh/i.test(language || ""));
      if (is404) {
        // 不存在的地址都落到中文的 404.html：地址在 en/ 下或要看英文时，换成英文的 404 页
        if (rest.startsWith("en/404") || want === "zh-CN") return;
        if (want === "en" || /^en(?:\/|$)/.test(rest) || !chineseBrowser)
          location.replace(`${base}en/404/`);
        return;
      }
      if (rest !== "" && rest !== "index.html") return;
      if (want === "zh-CN") return;
      if (want !== "en") {
        const from = document.referrer ? new URL(document.referrer) : null;
        if (from && from.origin === location.origin && from.pathname.startsWith(base)) return;
        if (chineseBrowser) return;
      }
      location.replace(`${base}en/${location.search}${location.hash}`);
    } catch {}
  })();
</script>
{!is404 && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<meta
  name="robots"
  content={indexable && !is404 ? "index, follow, max-image-preview:large" : "noindex, nofollow"}
/>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#212121" media="(prefers-color-scheme: dark)" />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={text.ogImageAlt} />
<meta name="twitter:image" content={image} />
<meta name="twitter:title" content={route.entry.data.title} />
<meta name="twitter:description" content={route.entry.data.description} />
{
  !is404 && (
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  )
}
<ImageZoom />

<script>
  // 滚动入场：只给首屏以下的内容加，首屏直接显示；没有 JS 或减少动态效果时什么都不做
  const SELECTOR = [
    ".sl-markdown-content > :is(h2, h3, p, ul, ol, table, blockquote, figure, aside, .expressive-code)",
    ".workroom-subhead",
    ".workroom-pathway",
    ".pagination-links > a",
  ].join(", ");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reduce.matches && "IntersectionObserver" in window) {
    const fold = window.innerHeight * 0.92;
    const pending = [...document.querySelectorAll<HTMLElement>(SELECTOR)].filter(
      (element) => element.getBoundingClientRect().top > fold,
    );
    if (pending.length) {
      document.documentElement.classList.add("docs-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          // 同一批进入视口的元素依次错开 70ms，最多错开 5 个
          let order = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const element = entry.target as HTMLElement;
            element.style.setProperty("--docs-reveal-delay", `${Math.min(order++, 5) * 70}ms`);
            element.classList.add("is-revealed");
            observer.unobserve(element);
            // 播完就摘掉，免得入场的过渡时长拖慢之后的悬停效果
            const done = (event: TransitionEvent) => {
              if (event.target !== element || event.propertyName !== "opacity") return;
              element.removeEventListener("transitionend", done);
              element.classList.remove("docs-reveal-item", "is-revealed");
              element.style.removeProperty("--docs-reveal-delay");
            };
            element.addEventListener("transitionend", done);
          }
        },
        { rootMargin: "0px 0px -6% 0px" },
      );
      for (const element of pending) {
        element.classList.add("docs-reveal-item");
        observer.observe(element);
      }
    }
  }
</script>
