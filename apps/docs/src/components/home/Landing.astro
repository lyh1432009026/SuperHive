---
// 文档站首页：首屏实景窗口 + 8 段滚动叙事。只在中英两个首页用（index.mdx 引入），其它文档页不受影响。
// 动效全部是渐进增强：没有 JS 时内容完整可读；减少动态效果时不漂浮、不逐字上色、不倾斜。
import HiveMark from "../../assets/hive-mark.svg";
import CollabModel from "../CollabModel.astro";
import { collabScenes } from "../collab-scenes";
import { localePath, pageLang } from "../i18n";
import { getSiteConfig, withBase } from "../../../scripts/site-config.mjs";
import { projectLinks, repoUrl } from "../../../scripts/project-links.mjs";
import { landingText } from "./landing-text";
import { runtimes } from "./runtime-logos";
import "./landing.css";

const { base } = getSiteConfig();
const lang = pageLang(Astro.locals);
const t = landingText[lang];
const s = t.sections;
const scenes = collabScenes[lang];
const to = (path: string) => localePath(path, lang, base);
const media = (name: string) => withBase(`media/home/${name}`, base);
const shot = (name: string, theme: "dark" | "light") => {
  const stem = `${name}.${lang === "en" ? "en." : ""}${theme}`;
  return {
    src: media(`${stem}.1600.webp`),
    srcset: [960, 1600, 2400].map((w) => `${media(`${stem}.${w}.webp`)} ${w}w`).join(", "),
  };
};
// 同一个标识在页面里出现多次（词云、手机网格各一份），渐变 id 加后缀；否则隐藏的那份会让另一份的渐变失效
const logoSvg = (runtime: (typeof runtimes)[number], suffix: string) =>
  runtime.svg.replaceAll(`hl-${runtime.id}-`, `hl-${runtime.id}-${suffix}-`);
const link = (key: string) =>
  projectLinks.find((item) =>
    key === "npm" ? item.href.includes("npmjs") : item.href.endsWith(`/${key}`),
  )!.href;

const sections = [
  { id: "solo", label: s.solo.label },
  { id: "team", label: s.team.label },
  { id: "agents", label: s.agents.label },
  { id: "permissions", label: s.permissions.label },
  { id: "im", label: s.im.label },
  { id: "progress", label: s.progress.label },
  { id: "install", label: s.install.label },
  { id: "community", label: s.community.label },
];
const num = (id: string) =>
  String(sections.findIndex((item) => item.id === id) + 1).padStart(2, "0");

// 逐字上色：中文按字，英文按词（保留空格）
const statementUnits =
  lang === "en" ? t.statement.text.split(/(\s+)/).filter(Boolean) : [...t.statement.text];

// 词云：运行时和能力名混排在 4 × 8 的格子里，用固定种子打乱再在格内抖动，构建结果稳定
const rand = (() => {
  let seed = 20261123;
  return () => {
    seed = (seed * 1664525 + 1013904223) % 4294967296;
    return seed / 4294967296;
  };
})();
const COLS = 4;
const ROWS = 8;
const cells = Array.from({ length: COLS * ROWS }, (_, index) => index);
for (let index = cells.length - 1; index > 0; index -= 1) {
  const swap = Math.floor(rand() * (index + 1));
  [cells[index], cells[swap]] = [cells[swap], cells[index]];
}
// 运行时放在离中心近的格子里，更醒目
const center = (cell: number) => {
  const col = cell % COLS;
  const row = Math.floor(cell / COLS);
  return Math.abs(col - 1.5) + Math.abs(row - 3.5) * 0.6;
};
const runtimeCells = [...cells].sort((a, b) => center(a) - center(b)).slice(0, runtimes.length);
const termCells = cells.filter((cell) => !runtimeCells.includes(cell));
const place = (cell: number, size: number) => {
  const col = cell % COLS;
  const row = Math.floor(cell / COLS);
  const x = ((col + 0.12 + rand() * 0.5) / COLS) * 100;
  const y = ((row + 0.15 + rand() * 0.6) / ROWS) * 100;
  const depth = (0.4 + rand() * 1.4) * size;
  const duration = 6 + rand() * 6;
  const delay = -rand() * 10;
  return `--x:${x.toFixed(1)}%;--y:${y.toFixed(1)}%;--d:${depth.toFixed(2)};--dur:${duration.toFixed(1)}s;--delay:${delay.toFixed(1)}s`;
};
const cloud = [
  ...runtimes.map((runtime, index) => ({
    kind: "runtime" as const,
    runtime,
    style: place(runtimeCells[index], 1),
  })),
  ...s.agents.terms.map((term, index) => ({
    kind: "term" as const,
    term,
    tier: index % 3,
    style: place(termCells[index % termCells.length], 0.6),
  })),
];
const marqueeRows = [s.agents.terms.slice(0, 12), s.agents.terms.slice(12)];

// 背景流动竖线：位置和节奏固定
const streaks = Array.from({ length: 16 }, (_, index) => ({
  x: ((index + 0.5) / 16) * 100,
  delay: -(rand() * 9).toFixed(1),
  dur: (6 + rand() * 7).toFixed(1),
  warm: index % 3 === 1,
}));
---

<div class="hl not-content" data-hl>
  <script is:inline>
    document.documentElement.classList.add("hl-js");
  </script>
  <div class="hl-progress" aria-hidden="true"><span data-hl-progress></span></div>

  <nav class="hl-dots" aria-label={t.nav}>
    <ol>
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`} data-hl-dot={section.id}>
              <span class="hl-dot-num">{String(index + 1).padStart(2, "0")}</span>
              <span class="hl-dot-label">{section.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- 首屏 -->
  <section class="hl-hero" aria-labelledby="_top">
    <div class="hl-hero-glow" aria-hidden="true"></div>
    <div class="hl-hero-copy">
      <p class="hl-eyebrow">
        <span class="hl-eyebrow-dot" aria-hidden="true"></span>
        {t.hero.eyebrow}
      </p>
      <h1 id="_top" data-page-title>
        <span class="hl-lead">{t.hero.titleLead}</span>
        <span class="hl-grad">{t.hero.titleRest}</span>
      </h1>
      <p class="hl-intro">{t.hero.intro}</p>
      <div class="hl-actions">
        <a class="hl-btn hl-btn-primary" href={to("start/quickstart/")}>
          {t.hero.primary}
          <span aria-hidden="true">→</span>
        </a>
        <a class="hl-btn hl-btn-ghost" href={to("start/overview/")}>{t.hero.secondary}</a>
        <div class="hl-cmd hl-cmd-pill">
          <code><span aria-hidden="true">$</span> npm i -g superhive</code>
          <button
            type="button"
            class="hl-copy"
            data-copy="npm i -g superhive"
            data-copied={t.hero.copied}
          >
            {t.hero.copy}
          </button>
        </div>
      </div>
    </div>

    <div class="hl-window-wrap">
      <div class="hl-window" data-hl-window>
        <div class="hl-window-bar">
          <span class="hl-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="hl-tabs" role="tablist" aria-label={t.hero.tabsLabel}>
            {
              t.hero.tabs.map((tab, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`hl-tab-${tab.id}`}
                  aria-controls={`hl-panel-${tab.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  data-hl-tab={tab.id}
                >
                  {tab.label}
                </button>
              ))
            }
          </div>
          <span class="hl-window-title">{t.hero.windowTitle}</span>
          <span class="hl-live"><i aria-hidden="true"></i>{t.hero.live}</span>
        </div>
        <div class="hl-window-body">
          {
            t.hero.tabs.map((tab, index) => {
              const dark = shot(tab.id === "room" ? "overview" : "preview-dock", "dark");
              const light = shot(tab.id === "room" ? "overview" : "preview-dock", "light");
              const first = index === 0;
              return (
                <div
                  class="hl-panel"
                  id={`hl-panel-${tab.id}`}
                  role="tabpanel"
                  aria-labelledby={`hl-tab-${tab.id}`}
                  data-hl-panel={tab.id}
                  hidden={!first}
                >
                  <img
                    class="hl-shot hl-shot-dark"
                    src={dark.src}
                    srcset={dark.srcset}
                    sizes="(min-width: 80rem) 72rem, 94vw"
                    width="2880"
                    height="1800"
                    alt={tab.alt}
                    loading={first ? "eager" : "lazy"}
                    fetchpriority={first ? "high" : "auto"}
                    decoding={first ? "sync" : "async"}
                  />
                  <img
                    class="hl-shot hl-shot-light"
                    src={light.src}
                    srcset={light.srcset}
                    sizes="(min-width: 80rem) 72rem, 94vw"
                    width="2880"
                    height="1800"
                    alt={tab.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="hl-hotspots">
                    {t.hero.hotspots[tab.id].map((spot, spotIndex) => (
                      <div
                        class="hl-spot"
                        style={`--sx:${spot.x}%;--sy:${spot.y}%`}
                        data-side={spot.x > 60 ? "left" : "right"}
                        data-low={spot.y > 55 ? "" : undefined}
                      >
                        <button
                          type="button"
                          aria-expanded="false"
                          aria-controls={`hl-spot-${tab.id}-${spotIndex}`}
                          aria-label={spot.title}
                        >
                          <span aria-hidden="true" />
                        </button>
                        <div
                          class="hl-spot-card"
                          id={`hl-spot-${tab.id}-${spotIndex}`}
                          role="note"
                          hidden
                        >
                          <strong>{spot.title}</strong>
                          <span>{spot.text}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
      <p class="hl-window-hint" aria-hidden="true">
        <span class="hl-hint-wide">{t.hero.hotspotHint}</span>
        <span class="hl-hint-narrow">{t.hero.hotspotHintNarrow}</span>
      </p>
    </div>
  </section>

  <!-- 一句话：滚动时逐字上色 -->
  <section class="hl-statement" aria-label={t.statement.label} data-hl-statement>
    <div class="hl-streaks" aria-hidden="true">
      {
        streaks.map((streak) => (
          <span
            class:list={{ "is-warm": streak.warm }}
            style={`--x:${streak.x}%;--delay:${streak.delay}s;--dur:${streak.dur}s`}
          />
        ))
      }
    </div>
    <div class="hl-statement-sticky">
      <p class="hl-statement-text">
        {
          statementUnits.map((unit) =>
            /^\s+$/.test(unit) ? unit : <span class="hl-w">{unit}</span>,
          )
        }
      </p>
    </div>
  </section>

  <!-- 01 单人 -->
  <section class="hl-section" id="solo" aria-labelledby="solo-title">
    <div class="hl-inner">
      <p class="hl-kicker"><b>{num("solo")}</b> · /{s.solo.label}</p>
      <h2 class="hl-h2" id="solo-title">
        <span class="hl-lead">{s.solo.head.lead}</span>
        <span class="hl-rest">{s.solo.head.rest}</span>
      </h2>
    </div>
    <div class="hl-diagram">
      <CollabModel scene={scenes.solo} />
    </div>
  </section>

  <!-- 02 多人 -->
  <section class="hl-section" id="team" aria-labelledby="team-title">
    <div class="hl-inner">
      <p class="hl-kicker"><b>{num("team")}</b> · /{s.team.label}</p>
      <h2 class="hl-h2" id="team-title">
        <span class="hl-lead">{s.team.head.lead}</span>
        <span class="hl-rest">{s.team.head.rest}</span>
      </h2>
    </div>
    <div class="hl-diagram">
      <CollabModel scene={scenes.team} />
    </div>
  </section>

  <!-- 03 运行时 -->
  <section
    class="hl-section hl-agents"
    id="agents"
    aria-labelledby="agents-title"
    data-hl-cloud-section
  >
    <div class="hl-cloud" aria-label={s.agents.cloudLabel} role="group" data-hl-cloud>
      {
        cloud.map((item) =>
          item.kind === "runtime" ? (
            <span class="hl-cloud-item hl-cloud-runtime" style={item.style}>
              <span class="hl-logo" set:html={logoSvg(item.runtime, "cloud")} />
              {item.runtime.name}
            </span>
          ) : (
            <span
              class:list={["hl-cloud-item", "hl-cloud-term", `hl-tier-${item.tier}`]}
              style={item.style}
            >
              {item.term}
            </span>
          ),
        )
      }
    </div>
    <div class="hl-inner hl-agents-copy">
      <p class="hl-kicker"><b>{num("agents")}</b> · /{s.agents.label}</p>
      <h2 class="hl-h2" id="agents-title">
        <span class="hl-lead">{s.agents.head.lead}</span>
        <span class="hl-rest">{s.agents.head.rest}</span>
      </h2>
      <p class="hl-body">{s.agents.intro}</p>
      <p class="hl-stat">
        <span class="hl-stat-num hl-grad">{s.agents.count}</span>
        <span class="hl-stat-unit">{s.agents.countUnit}</span>
      </p>
      <ul class="hl-runtime-grid">
        {
          runtimes.map((runtime) => (
            <li>
              <span class="hl-logo" set:html={logoSvg(runtime, "grid")} />
              {runtime.name}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hl-marquee" aria-hidden="true">
      {
        marqueeRows.map((row, index) => (
          <div class:list={["hl-marquee-row", { "is-reverse": index === 1 }]}>
            <div>
              {[...row, ...row].map((term) => (
                <span>{term}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 04 权限 -->
  <section class="hl-section" id="permissions" aria-labelledby="permissions-title">
    <div class="hl-inner">
      <p class="hl-kicker"><b>{num("permissions")}</b> · /{s.permissions.label}</p>
      <h2 class="hl-h2" id="permissions-title">
        <span class="hl-lead">{s.permissions.head.lead}</span>
        <span class="hl-rest">{s.permissions.head.rest}</span>
      </h2>
      <p class="hl-body">{s.permissions.intro}</p>
      <div class="hl-perm">
        <ol class="hl-tiers">
          {
            s.permissions.tiers.map((tier, index) => (
              <li class:list={["hl-tier", { "is-default": tier.badge }]} style={`--level:${index}`}>
                <span class="hl-tier-meter" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
                <h3>
                  {tier.name}
                  {tier.badge && <span class="hl-badge">{tier.badge}</span>}
                </h3>
                <code>{tier.flag}</code>
                <p>{tier.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="hl-ask" aria-hidden="true">
          <div class="hl-ask-head">
            <span
              class="hl-logo hl-ask-logo"
              set:html={logoSvg(
                runtimes.find((r) => r.id === "codex")!,
                "ask",
              )}
            />
            <span>{s.permissions.ask.who}</span>
            <span class="hl-ask-timer">{s.permissions.ask.pending}</span>
          </div>
          <strong>{s.permissions.ask.title}</strong>
          <code>{s.permissions.ask.path}</code>
          <div class="hl-ask-actions">
            <span class="hl-ask-allow">{s.permissions.ask.allow}</span>
            <span class="hl-ask-deny">{s.permissions.ask.deny}</span>
          </div>
          <p>{s.permissions.ask.note}</p>
        </div>
      </div>
      <a class="hl-more" href={to("guides/permissions/")}
        >{s.permissions.more} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <!-- 05 IM -->
  <section class="hl-section" id="im" aria-labelledby="im-title">
    <div class="hl-inner hl-im">
      <div class="hl-im-copy">
        <p class="hl-kicker"><b>{num("im")}</b> · /{s.im.label}</p>
        <h2 class="hl-h2" id="im-title">
          <span class="hl-lead">{s.im.head.lead}</span>
          <span class="hl-rest">{s.im.head.rest}</span>
        </h2>
        <p class="hl-body">{s.im.intro}</p>
      </div>
      <div class="hl-im-detail">
        <dl class="hl-channels">
          {
            s.im.channels.map((channel) => (
              <div>
                <dt>{channel.name}</dt>
                <dd>{channel.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="hl-note">{s.im.note}</p>
        <a class="hl-more" href={to("guides/im/")}>{s.im.more} <span aria-hidden="true">→</span></a>
      </div>
      <div class="hl-phone" aria-hidden="true">
        <div class="hl-phone-screen">
          <div class="hl-phone-top">
            <span class="hl-phone-island"></span>
          </div>
          <div class="hl-phone-head">
            <HiveMark width="18" height="18" />
            <span>{s.im.phoneTitle}</span>
          </div>
          <div class="hl-chat">
            <div class="hl-bubble hl-bubble-me">{s.im.chat.me}</div>
            <div class="hl-card">
              <span class="hl-card-who is-done">{s.im.chat.doneWho}</span>
              <p>{s.im.chat.doneText}</p>
              <span class="hl-card-file">
                <svg viewBox="0 0 16 16" aria-hidden="true"
                  ><path d="M4 1.5h5L12.5 5v9.5h-8.5zM9 1.5V5h3.5"></path></svg
                >
                {s.im.chat.file}
              </span>
            </div>
            <div class="hl-card hl-card-ask">
              <span class="hl-card-who is-ask">{s.im.chat.askWho}</span>
              <p>{s.im.chat.askText}</p>
              <div class="hl-card-options">
                {
                  s.im.chat.options.map((option, index) => (
                    <span class:list={{ "is-picked": index === 0 }}>
                      {String.fromCharCode(65 + index)} · {option}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="hl-phone-input">
            {s.im.inputHint}
            <i></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 进展、白板、故障 -->
  <section class="hl-section" id="progress" aria-labelledby="progress-title" data-hl-stages>
    <div class="hl-inner">
      <p class="hl-kicker"><b>{num("progress")}</b> · /{s.progress.label}</p>
      <h2 class="hl-h2" id="progress-title">
        <span class="hl-lead">{s.progress.head.lead}</span>
        <span class="hl-rest">{s.progress.head.rest}</span>
      </h2>
      <ol class="hl-stages">
        {
          s.progress.stages.map((stage, index) => (
            <li class="hl-stage" data-hl-stage={index}>
              <span class="hl-stage-dot" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>
                {stage.name}
                <span> · {stage.state}</span>
              </h3>
              <p>{stage.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="hl-tiles">
        {
          s.progress.tiles.map((tile) => (
            <div class="hl-tile">
              <p class="hl-tile-kicker">{tile.kicker}</p>
              <h3>{tile.title}</h3>
              <p>{tile.text}</p>
            </div>
          ))
        }
      </div>
      <a class="hl-more" href={to("guides/tasks/")}
        >{s.progress.more} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <!-- 07 安装 -->
  <section class="hl-section" id="install" aria-labelledby="install-title">
    <div class="hl-inner">
      <p class="hl-kicker"><b>{num("install")}</b> · /{s.install.label}</p>
      <h2 class="hl-h2" id="install-title">
        <span class="hl-lead">{s.install.head.lead}</span>
        <span class="hl-rest">{s.install.head.rest}</span>
      </h2>
      <p class="hl-body">{s.install.intro}</p>
      <ol class="hl-steps">
        {
          s.install.steps.map((step) => (
            <li class="hl-step">
              <p class="hl-step-num">{step.step}</p>
              <h3>{step.title}</h3>
              <div class="hl-cmd">
                <code>
                  <span aria-hidden="true">$</span> {step.command}
                </code>
                <button
                  type="button"
                  class="hl-copy"
                  data-copy={step.command}
                  data-copied={t.hero.copied}
                >
                  {t.hero.copy}
                </button>
              </div>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="hl-note">{s.install.note}</p>
      <a class="hl-more" href={to("start/installation/")}
        >{s.install.more} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <!-- 08 社区 -->
  <section class="hl-section hl-community" id="community" aria-labelledby="community-title">
    <div class="hl-inner">
      <p class="hl-kicker"><b>{num("community")}</b> · /{s.community.label}</p>
      <h2 class="hl-h2" id="community-title">
        <span class="hl-lead">{s.community.head.lead}</span>
        <span class="hl-rest">{s.community.head.rest}</span>
      </h2>
      <p class="hl-body">{s.community.intro}</p>
      <div class="hl-links">
        <a class="hl-link hl-link-repo" href={repoUrl} rel="noopener">
          <svg class="hl-gh" viewBox="0 0 24 24" aria-hidden="true">
            <path
