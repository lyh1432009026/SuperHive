---
import HiveMark from "../assets/hive-mark.svg";
import { getSiteConfig, withBase } from "../../scripts/site-config.mjs";

const { base } = getSiteConfig();

const marks: Record<string, string> = {
  claude: "M12 2v20M2 12h20M5 5l14 14M5 19 19 5",
  codex: "m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18",
  omp: "M3 4h18v16H3V4Zm4 4 3 4-3 4m6 0h4",
};

// 三个人各自的电脑；node 是动画里高亮用的标识，样式里按步骤引用。
const machines = [
  {
    owner: "你",
    node: "you",
    agents: [
      { name: "claude", kind: "claude", task: "统筹 · review" },
      { name: "codex", kind: "codex", task: "写代码" },
    ],
  },
  {
    owner: "林夏",
    node: "lin",
    agents: [
      { name: "lin-codex", kind: "codex", task: "修结算页" },
      { name: "lin-omp", kind: "omp", task: "整理文档" },
    ],
  },
  {
    owner: "周远",
    node: "zhou",
    agents: [
      { name: "zhou-claude", kind: "claude", task: "补测试" },
      { name: "zhou-omp", kind: "omp", task: "跑验证" },
    ],
  },
];

// 五种协作关系；动画按这个顺序轮播，样式里的 data-step 选择器与之对应。
const steps = [
  { title: "派活", detail: "你在房间里 @lin-codex，把结算页的修复派给林夏电脑上的 Agent。" },
  { title: "跨电脑委派", detail: "lin-codex 拆出「补边界测试」，委派给周远电脑上的 zhou-claude。" },
  { title: "登记白板", detail: "zhou-claude 补好测试后登记到白板，谁都看得到它已就绪。" },
  { title: "回到人手里", detail: "要不要重算旧订单？lin-codex 停下来问你，你点选后它继续。" },
  { title: "交回成果", detail: "lin-codex 交回提交和测试结果，你的 claude 接着 review。" },
];
const last = steps.length - 1;
---

<figure
  class="cm not-content"
  data-step={last}
  aria-labelledby="cm-title"
  aria-describedby="cm-desc"
>
  <div class="cm-frame">
    <div class="cm-head">
      <p class="cm-kicker" id="cm-title">每个人带着自己的 Agent，在同一个房间里协作</p>
      <span class="cm-head-side">
        <span class="cm-badge">示意图</span>
        <button type="button" class="cm-toggle" data-cm-toggle aria-pressed="false" hidden>
          <svg class="cm-icon-pause" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.5v9M11 3.5v9"></path>
          </svg>
          <svg class="cm-icon-play" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.2v9.6L12.5 8 5 3.2Z"></path>
          </svg>
          <span data-cm-toggle-label>暂停</span>
        </button>
      </span>
    </div>
    <p class="cm-sr" id="cm-desc">
      示意图：你、林夏、周远三个人各自在自己的电脑上运行两个 Agent。三台电脑都连到同一个 SuperHive
      房间，房间里只有公开消息、协作白板和等人回答的问题；文件、权限和会话留在各自的电脑上。下面的五个步骤说明大家怎样通过房间协作。
    </p>

    <div class="cm-stage" aria-hidden="true">
      <div class="cm-machines">
        {
          machines.map((machine, index) => (
            <div class:list={["cm-machine", { "cm-machine-you": index === 0 }]}>
              <div class="cm-owner" data-node={machine.node}>
                <span class="cm-avatar">{machine.owner.slice(0, 1)}</span>
                <span class="cm-owner-text">
                  <strong>{machine.owner}</strong>
                  <span>{index === 0 ? "你的电脑" : `${machine.owner}的电脑`}</span>
                </span>
              </div>
              <ul class="cm-agents">
                {machine.agents.map((agent) => (
                  <li data-node={agent.name}>
                    <svg viewBox="0 0 24 24">
                      <path d={marks[agent.kind]} />
                    </svg>
                    <span class="cm-agent-text">
                      <strong>{agent.name}</strong>
                      <span>{agent.task}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <div class="cm-local">
                <svg viewBox="0 0 16 16">
                  <rect x="3" y="7" width="10" height="7" rx="1.5" />
                  <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
                </svg>
                <span class="cm-local-long">文件 · 权限 · 会话留在本机</span>
                <span class="cm-local-short">留在本机</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="cm-wires">
        {
          machines.map((_, index) => (
            <span class:list={["cm-wire", `cm-wire-${index}`]}>
              <span class="cm-dot cm-dot-down" />
              <span class="cm-dot cm-dot-up" />
            </span>
          ))
        }
      </div>

      <div class="cm-room">
        <div class="cm-room-head">
          <HiveMark width={26} height={26} />
          <span class="cm-room-name">
            <strong># shop-web</strong>
            <span>同一个 SuperHive 房间</span>
          </span>
          <span class="cm-room-note">只走公开消息</span>
        </div>
        <div class="cm-zones">
          <div class="cm-zone cm-zone-msg">
            <span class="cm-zone-title">公开消息</span>
            <p class="cm-line cm-l0"><b>你</b> @lin-codex 修一下结算页的四舍五入</p>
            <p class="cm-line cm-l1"><b>lin-codex</b> @zhou-claude 帮忙补边界测试</p>
            <p class="cm-line cm-l4"><b>lin-codex</b> 已修复，提交 a41c9e2，请 review</p>
          </div>
          <div class="cm-zone cm-zone-board">
            <span class="cm-zone-title">协作白板</span>
            <p class="cm-line cm-l01">
              结算页修复 <span class="cm-pill">进行中</span>
            </p>
            <p class="cm-line cm-l2">
              边界测试 <span class="cm-pill cm-pill-ok">已就绪</span>
            </p>
          </div>
          <div class="cm-zone cm-zone-ask">
            <span class="cm-zone-title">等你回答</span>
            <p class="cm-line cm-l3">旧订单要一起重算吗？</p>
            <span class="cm-options">
              <span class="cm-option cm-option-pick">A 只修新订单</span>
              <span class="cm-option">B 一起重算</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <ol class="cm-steps">
      {
        steps.map((step, index) => (
          <li>
            <button
              type="button"
              class="cm-step"
              data-go={index}
              aria-current={index === last ? "step" : undefined}
            >
              <span class="cm-step-dot" aria-hidden="true">
                {index + 1}
              </span>
              <span class="cm-step-text">
                <strong>{step.title}</strong>
                <span>{step.detail}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <figcaption>
    <span>示意图，人名、Agent 名和任务均为演示数据。</span>
    <a href={withBase("guides/collaboration/", base)}>
      了解委派、进展与提问 <span aria-hidden="true">→</span>
    </a>
  </figcaption>
</figure>

<script>
  const STEP_MS = 3600;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const figure of document.querySelectorAll<HTMLElement>(".cm")) {
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const toggle = figure.querySelector<HTMLButtonElement>("[data-cm-toggle]");
    const toggleLabel = figure.querySelector<HTMLElement>("[data-cm-toggle-label]");
    const last = buttons.length - 1;
    let step = last;
    let timer = 0;
    let paused = reduce.matches;
    let visible = false;

    const show = (next: number) => {
      step = next;
      figure.dataset.step = String(step);
      buttons.forEach((button, index) => {
        if (index === step) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
      });
      // 重新挂上 is-run，让这一步的连线动画从头播放
      figure.classList.remove("is-run");
      void figure.offsetWidth;
      figure.classList.toggle("is-run", !paused);
    };

    const schedule = () => {
      clearTimeout(timer);
      if (paused || !visible || document.hidden) return;
      timer = window.setTimeout(
        () => {
          show(step === last ? 0 : step + 1);
          schedule();
        },
        STEP_MS + (step === last ? 1200 : 0),
      );
    };

    const setPaused = (value: boolean) => {
      paused = value;
      figure.classList.toggle("is-paused", paused);
      if (toggle && toggleLabel) {
        toggle.setAttribute("aria-pressed", String(paused));
        toggleLabel.textContent = paused ? "播放" : "暂停";
      }
      schedule();
    };

    buttons.forEach((button, index) =>
      button.addEventListener("click", () => {
        setPaused(true);
        show(index);
      }),
    );
    toggle?.addEventListener("click", () => {
      setPaused(!paused);
      if (!paused) show(step === last ? 0 : step + 1);
    });

    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      figure.classList.toggle("is-offscreen", !visible);
      // 重新进入视野时从第一步讲起
      if (visible && !wasVisible && !paused) show(0);
      schedule();
    }).observe(figure);
    document.addEventListener("visibilitychange", schedule);

    // 减少动态效果时不启动轮播，保留完整的静态图
    if (!reduce.matches) {
      if (toggle) toggle.hidden = false;
      figure.classList.add("is-live");
    }
  }
</script>

<style>
  .cm {
    --cm-ok: #1f8a5b;
    --cm-warn: #b86e00;
    --cm-line: var(--sl-color-gray-5);
    --cm-panel: var(--sl-color-bg-sidebar);
    --cm-surface: var(--sl-color-bg);
    --cm-raised: var(--sl-color-gray-6);
    --cm-wire-h: 3.25rem;
    --cm-ms: 3600ms;
    --cm-ease: cubic-bezier(0.22, 1, 0.36, 1);
    min-width: 0;
    margin: 0;
  }

  :global(:root:not([data-theme="light"])) .cm {
    --cm-ok: #4cc38a;
    --cm-warn: #f0b252;
    --cm-panel: #181818;
    --cm-surface: #1d1d1d;
    --cm-raised: #2a2a2a;
  }

  .cm-frame {
    padding: 1.25rem;
    border: 1px solid var(--cm-line);
    border-radius: 1.25rem;
    background: var(--cm-panel);
    color: var(--sl-color-white);
    line-height: 1.5;
    text-align: left;
  }

  .cm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .cm-kicker {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cm-badge {
    flex-shrink: 0;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--cm-line);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
  }

  .cm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cm-stage svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 三台电脑 */
  .cm-machines,
  .cm-wires {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .cm-machine {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.9rem;
    background: var(--cm-surface);
  }

  .cm-machine-you {
    border-color: var(--sl-color-gray-4);
  }

  .cm-owner {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .cm-avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--cm-raised);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 650;
    transition:
      background-color 250ms ease,
      color 250ms ease,
      box-shadow 250ms ease;
  }

  .cm-machine-you .cm-avatar {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .cm-owner-text,
  .cm-agent-text {
    display: grid;
    min-width: 0;
  }

  .cm-owner-text strong {
    font-size: 0.85rem;
    font-weight: 650;
  }

  .cm-owner-text span,
  .cm-agent-text span {
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-agents {
    display: grid;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cm-agents li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.55rem;
    background: var(--cm-panel);
    transition:
      border-color 250ms ease,
      background-color 250ms ease;
  }

  .cm-agents svg {
    flex-shrink: 0;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--sl-color-accent);
  }

  .cm-agent-text strong {
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-local {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--cm-line);
    color: var(--sl-color-gray-3);
    font-size: 0.66rem;
    white-space: nowrap;
  }

  .cm-local svg {
    flex-shrink: 0;
    width: 0.8rem;
    height: 0.8rem;
    stroke-width: 1.5;
  }

  .cm-local-short {
    display: none;
  }

  /* 电脑与房间之间的连线 */
  .cm-wire {
    position: relative;
    height: var(--cm-wire-h);
  }

  .cm-wire::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    border-left: 1.5px dashed var(--sl-color-gray-4);
    content: "";
    transition: border-color 250ms ease;
  }

  .cm-wire::after {
    position: absolute;
    top: 50%;
    left: calc(50% + 0.6rem);
    color: var(--sl-color-accent-high);
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .cm-dot {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin: -0.275rem 0 0 calc(-0.275rem + 0.75px);
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
    opacity: 0;
  }

  /* 房间 */
  .cm-room {
    padding: 0.9rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.9rem;
    background: var(--cm-surface);
    box-shadow: 0 12px 40px -24px rgb(0 0 0 / 0.35);
  }

  .cm-room-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cm-room-head > svg {
    flex-shrink: 0;
    stroke-width: 2.4;
  }

  .cm-room-name {
    display: grid;
    min-width: 0;
  }

  .cm-room-name strong {
    font-size: 0.88rem;
    font-weight: 650;
  }

  .cm-room-name span {
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
  }

  .cm-room-note {
    margin-left: auto;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .cm-zones {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .cm-zone {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.6rem;
    background: var(--cm-panel);
  }

  .cm-zone-title {
    margin-bottom: 0.1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cm-line {
    margin: 0;
    padding: 0.1rem 0.35rem;
    margin-inline: -0.35rem;
    border-radius: 0.35rem;
    overflow: hidden;
    color: var(--sl-color-gray-2);
    font-size: 0.74rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .cm-line b {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .cm-pill {
    display: inline-block;
    margin-left: 0.2rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.64rem;
    font-weight: 600;
  }

  .cm-pill-ok {
    background: color-mix(in srgb, var(--cm-ok) 16%, transparent);
    color: var(--cm-ok);
  }

  .cm-zone-ask {
    border-color: color-mix(in srgb, var(--cm-warn) 45%, var(--cm-line));
  }

  .cm-zone-ask .cm-zone-title {
    color: var(--cm-warn);
  }

  .cm-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .cm-option {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.4rem;
    background: var(--cm-surface);
    font-size: 0.66rem;
    white-space: nowrap;
    transition:
      border-color 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .cm:not(.is-live) .cm-option-pick,
  .cm.is-live[data-step="3"] .cm-option-pick,
  .cm.is-live[data-step="4"] .cm-option-pick {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  /* 下方的五种协作关系 */
  .cm-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cm-steps li {
    display: flex;
    margin: 0;
  }

  .cm-step {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    padding: 0.6rem;
    border: 0;
    border-radius: 0.7rem;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 250ms ease,
      box-shadow 250ms ease;
  }

  .cm-step:hover {
    background: var(--cm-raised);
  }

  .cm-step-dot {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      color 250ms ease;
  }

  .cm-step-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .cm-step-text strong {
    color: var(--sl-color-white);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cm-step-text span {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .cm.is-live .cm-step[aria-current] {
    background: var(--cm-surface);
    box-shadow: inset 0 0 0 1px var(--cm-line);
  }

  .cm.is-live .cm-step[aria-current] .cm-step-dot {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .cm-head-side {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .cm-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem 0.25rem 0.45rem;
    border: 1px solid var(--cm-line);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .cm-toggle[hidden] {
