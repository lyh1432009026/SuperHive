---
import { Icon } from "@astrojs/starlight/components";
import { localePath, pageLang, ui, type Lang } from "./i18n";
import { getSiteConfig } from "../../scripts/site-config.mjs";

// 两种语言：跟主题切换一样的下拉样式。选项是普通链接，没有 JS 也能切换；
// 有 JS 时点选会记住选择，之后进站按这个语言来（见 Head.astro 里的跳转）。
const { base } = getSiteConfig();
const lang = pageLang(Astro.locals);
const route = Astro.locals.starlightRoute;
// 同一页在另一种语言下的地址；404 页回各自语言的首页
const pageId = route.id.replace(/^en(?:\/|$)/, "");
const path = pageId && pageId !== "404" ? `${pageId}/` : "";
const options: { value: Lang; label: string; short: string }[] = [
  { value: "zh-CN", label: "简体中文", short: "中文" },
  { value: "en", label: "English", short: "EN" },
];
const current = options.find((option) => option.value === lang)!;
const label = Astro.locals.t("languageSelect.accessibleLabel");
---

<hive-lang-select>
  <details class="lang-select">
    <summary class="lang-trigger" aria-label={`${label}: ${current.label}`}>
      <Icon name="translate" class="lang-trigger-icon" />
      <span class="lang-trigger-label">{current.short}</span>
      <Icon name="down-caret" class="lang-caret" />
    </summary>
    <div class="lang-menu">
      <span class="lang-menu-heading" aria-hidden="true">{ui[lang].langHeading}</span>
      {
        options.map((option) => (
          <a
            class="lang-option"
            href={localePath(path, option.value, base)}
            hreflang={option.value}
            lang={option.value}
            data-lang={option.value}
            aria-current={option.value === lang ? "true" : undefined}
          >
            <span>{option.label}</span>
            <Icon name="approve-check" class="lang-check" />
          </a>
        ))
      }
    </div>
  </details>
</hive-lang-select>

<script>
  class HiveLangSelect extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const details = this.querySelector("details");
      if (!details) return;
      const close = (restoreFocus = false) => {
        if (!details.open) return;
        details.open = false;
        if (restoreFocus) details.querySelector("summary")?.focus();
      };

      this.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((option) => {
        option.addEventListener(
          "click",
          () => {
            try {
              localStorage.setItem("superhive.docs.locale", option.dataset.lang!);
            } catch {
              // 存不了就只切这一次，站内跳转不会被自动跳回
            }
          },
          { signal },
        );
      });
      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && details.open) {
            event.preventDefault();
            event.stopPropagation();
            close(true);
          }
        },
        { signal },
      );
      this.addEventListener(
        "focusout",
        (event) => {
          if (!(event.relatedTarget instanceof Node) || !this.contains(event.relatedTarget))
            close();
        },
        { signal },
      );
      document.addEventListener(
        "pointerdown",
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target)) close();
        },
        { signal },
      );
      // 从缓存返回时收起菜单
      window.addEventListener("pageshow", () => close(), { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get("hive-lang-select")) {
    customElements.define("hive-lang-select", HiveLangSelect);
  }
</script>

<style>
  hive-lang-select {
    position: relative;
    display: inline-block;
  }

  .lang-trigger,
  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    cursor: pointer;
  }

  .lang-trigger {
    min-height: 2.25rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    list-style: none;
    user-select: none;
    transition:
      background 150ms,
      border-color 150ms;
  }

  .lang-trigger::-webkit-details-marker {
    display: none;
  }

  .lang-trigger:hover,
  .lang-select[open] .lang-trigger {
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }

  .lang-trigger:focus-visible,
  .lang-option:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  .lang-trigger-icon {
    color: var(--sl-color-gray-2);
    flex-shrink: 0;
  }

  .lang-caret {
    margin-inline-start: 0.125rem;
    color: var(--sl-color-gray-3);
    transition: transform 150ms;
  }

  .lang-select[open] .lang-caret {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    z-index: 10;
    width: 11rem;
    max-width: calc(100vw - 2rem);
    padding: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem;
    background: var(--sl-color-bg-nav);
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.14),
      0 2px 6px rgb(0 0 0 / 0.06);
  }

  .lang-menu-heading {
    display: block;
    padding: 0.375rem 0.625rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }

  .lang-option {
    min-height: 2.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    text-decoration: none;
  }

  .lang-option:hover,
  .lang-option:focus-visible,
  .lang-option[aria-current="true"] {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
  }

  .lang-check {
    margin-inline-start: auto;
    visibility: hidden;
  }

  .lang-option[aria-current="true"] .lang-check {
    visibility: visible;
  }

  :global(.mobile-preferences) .lang-menu {
    inset-block-start: auto;
    inset-block-end: calc(100% + 0.5rem);
  }

  /* 顶栏窄屏只留图标，省出搜索和菜单按钮的位置 */
  @media (max-width: 30rem) {
    :global(.hive-header-social) .lang-trigger-label,
    :global(.hive-header-social) .lang-caret {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-trigger,
    .lang-caret {
      transition: none;
    }
  }
</style>
