---
import DefaultHeader from "@astrojs/starlight/components/Header.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
---

<div class="hive-header">
  <DefaultHeader />
  {/* 窄屏时 Starlight 把社交图标收进侧栏菜单，首页没有侧栏就看不到；这里在顶栏单独放一份 */}
  <div class="hive-header-social print:hidden">
    <SocialIcons />
  </div>
</div>

<style>
  .hive-header {
    display: flex;
    gap: var(--sl-nav-gap);
    align-items: center;
    height: 100%;
  }

  .hive-header > :global(.header) {
    flex: 1;
    min-width: 0;
  }

  .hive-header-social {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  @media (min-width: 50rem) {
    .hive-header-social {
      display: none;
    }
  }
</style>
