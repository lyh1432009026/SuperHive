---
import DefaultThemeProvider from "@astrojs/starlight/components/ThemeProvider.astro";

// 文档站默认深色：用户没在主题菜单里亲手选过时一律用深色；选过（深色、浅色或「跟随系统」）就以用户选的为准。
// 选过的标记在下面监听主题菜单的 change 时写入。Starlight 的主题脚本加载后会按系统偏好重设一次，这里盯住 data-theme，在绘制前改回深色。
---

<DefaultThemeProvider />
<script is:inline>
  (() => {
    const root = document.documentElement;
    const chosen = () => {
      try {
        return (
          localStorage.getItem("superhive.docs.theme-chosen") === "1" ||
          ["light", "dark"].includes(localStorage.getItem("starlight-theme") || "")
        );
      } catch {
        return false;
      }
    };
    // 没选过时，菜单里的「深色」后面标上「默认」，和用户自己选的区分开（只改显示，不算用户选过）；
    // 顶栏按钮的文字不动，免得宽度变化引起布局偏移
    const DEFAULT_LABEL = root.lang === "en" ? "Default" : "默认";
    const syncPickers = () => {
      const isDefault = !chosen();
      document.querySelectorAll("hive-theme-select").forEach((picker) => {
        const select = picker.querySelector("starlight-theme-select select");
        if (isDefault && select && select.value !== "dark") {
          select.value = "dark";
          select.dispatchEvent(new Event("hive-theme-sync"));
        }
        const option = picker.querySelector('.theme-option[data-theme="dark"]');
        let tag = option?.querySelector(".theme-default-tag");
        if (isDefault && option && !tag) {
          tag = document.createElement("span");
          tag.className = "theme-default-tag";
          tag.textContent = DEFAULT_LABEL;
          tag.style.cssText =
            "margin-inline-start:auto;padding:0 .4em;border-radius:999px;font-size:.72em;opacity:.75;border:1px solid currentColor";
          option.querySelector("span")?.after(tag);
        }
        if (!isDefault) tag?.remove();
      });
    };
    const force = () => {
      if (!chosen() && root.dataset.theme !== "dark") root.dataset.theme = "dark";
      syncPickers();
    };
    // 用户在主题菜单里选了（包括「跟随系统」）就记下，之后以用户选的为准；捕获阶段先记，Starlight 改主题时已经算选过
    document.addEventListener(
      "change",
      (event) => {
        if (!event.target?.closest?.("starlight-theme-select")) return;
        try {
          localStorage.setItem("superhive.docs.theme-chosen", "1");
        } catch {}
        setTimeout(syncPickers);
      },
      true,
    );
    force();
    document.addEventListener("DOMContentLoaded", () =>
      customElements.whenDefined("hive-theme-select").then(syncPickers),
    );
    new MutationObserver(force).observe(root, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>
