---
import DefaultHero from "@astrojs/starlight/components/Hero.astro";
import CollabModel from "./CollabModel.astro";
import { soloScene, teamScene } from "./collab-scenes";
import { getSiteConfig, withBase } from "../../scripts/site-config.mjs";

const { base } = getSiteConfig();
const isHome = Astro.locals.starlightRoute.id === "";
const PAGE_TITLE_ID = "_top";
---

{
  isHome ? (
    <section class="workroom-hero" aria-labelledby={PAGE_TITLE_ID}>
      <div class="workroom-copy">
        <p class="workroom-eyebrow">自己部署 · 公开协作 · 权限留在本机</p>
        <h1 id={PAGE_TITLE_ID} data-page-title>
          把人和 Agent，带进同一间工作室。
        </h1>
        <p class="workroom-intro">
          从第一个 Agent，到一整个协作团队。把安装、派活、审批和交付，一步步讲清楚。
        </p>
        <div class="workroom-actions">
          <a class="workroom-primary" href={withBase("start/quickstart/", base)}>
            开始上手 <span aria-hidden="true">→</span>
          </a>
          <a class="workroom-secondary" href={withBase("start/overview/", base)}>
            浏览功能地图
          </a>
        </div>
      </div>
      <CollabModel scene={teamScene} />
      <div class="workroom-subhead">
        <h2>一个人，也能带一支 Agent 队伍</h2>
        <p>
          不用凑齐团队：你接上十个 Agent，让它们互相委派、并行干活、汇总
          review，自己闭环，你只在关键处拍板。
        </p>
      </div>
      <CollabModel scene={soloScene} />
    </section>
  ) : (
    <DefaultHero />
  )
}
