---
import { getSiteConfig, withBase } from "../../scripts/site-config.mjs";

const { base } = getSiteConfig();

// 一次完整协作的六个阶段；动画与左侧步骤共用这份数据。
const steps = [
  { title: "提及 Agent", detail: "在房间里 @ 一个 Agent，把目标说清楚。", ms: 3000 },
  { title: "认领任务", detail: "Agent 接下任务，状态对所有人可见。", ms: 2600 },
  { title: "执行", detail: "在自己的电脑和目录里改代码、跑测试。", ms: 3600 },
  { title: "提问或审批", detail: "遇到取舍或需要授权，停下来问你。", ms: 4200 },
  { title: "交付成果", detail: "交回结果、提交和验证依据。", ms: 3400 },
  { title: "review 合入", detail: "请另一个 Agent 复审，通过后合入。", ms: 4400 },
];
const last = steps.length - 1;
const reached = steps.map((_, index) => `s${index}`).join(" ");

const marks: Record<string, string> = {
  claude: "M12 2v20M2 12h20M5 5l14 14M5 19 19 5",
  codex: "m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18",
};
const members = [
  { name: "你", kind: "human" },
  { name: "林夏", kind: "human" },
  { name: "claude", kind: "agent" },
  { name: "codex", kind: "agent" },
];
---

<figure
  class:list={["flow", reached]}
  data-step={last}
  aria-labelledby="flow-title"
  style={`--flow-steps: ${steps.length}`}
>
  <div class="flow-frame">
    <div class="flow-side">
      <p class="flow-kicker" id="flow-title">一次完整协作的流转</p>
      <ol class="flow-steps">
        {
          steps.map((step, index) => (
            <li>
              <button
                type="button"
                class="flow-step"
                data-go={index}
                data-ms={step.ms}
                aria-current={index === last ? "step" : undefined}
              >
                <span class="flow-step-dot" aria-hidden="true">
                  {index + 1}
                </span>
                <span class="flow-step-text">
                  <strong>{step.title}</strong>
                  <span>{step.detail}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <p class="flow-now" aria-hidden="true">
        <strong data-flow-now-title>{steps[last].title}</strong>
        <span data-flow-now-detail>{steps[last].detail}</span>
      </p>
      <div class="flow-controls">
        <button type="button" class="flow-toggle" data-flow-toggle aria-pressed="false" hidden>
          <svg class="flow-icon-pause" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.5v9M11 3.5v9"></path>
          </svg>
          <svg class="flow-icon-play" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.2v9.6L12.5 8 5 3.2Z"></path>
          </svg>
          <span data-flow-toggle-label>暂停</span>
        </button>
        <span class="flow-progress" aria-hidden="true"><span></span></span>
      </div>
    </div>

    <div class="flow-window" aria-hidden="true">
      <div class="flow-titlebar">
        <span class="flow-room"># shop-web</span>
        <span class="flow-members">
          {
            members.map((member) => (
              <span
                class:list={[
                  "flow-member",
                  `flow-member-${member.kind}`,
                  `flow-member-${member.name}`,
                ]}
                title={member.name}
              >
                {member.kind === "agent" ? (
                  <svg viewBox="0 0 24 24">
                    <path d={marks[member.name]} />
                  </svg>
                ) : (
                  member.name.slice(0, 1)
                )}
              </span>
            ))
          }
        </span>
      </div>

      <div class="flow-feed">
        <div class="flow-feed-inner">
          <div class="flow-msg flow-context">
            <span class="flow-avatar">林</span>
            <div class="flow-bubble">
              <span class="flow-name">林夏</span>
              <p>有用户反馈结算页的总价偶尔差 1 分钱。</p>
            </div>
          </div>
          <div class="flow-divider"><span>今天 10:24</span></div>
          <div class="flow-msg flow-at-0">
            <span class="flow-avatar flow-avatar-you">你</span>
            <div class="flow-bubble">
              <span class="flow-name">你</span>
              <p>
                <span class="flow-mention">@codex</span> 结算页的价格四舍五入不对，修一下并补上测试。
              </p>
            </div>
          </div>

          <div class="flow-msg flow-at-1">
            <span class="flow-avatar flow-avatar-agent">
              <svg viewBox="0 0 24 24"><path d={marks.codex}></path></svg>
            </span>
            <div class="flow-task">
              <div class="flow-task-head">
                <span class="flow-name">codex</span>
                <span class="flow-pill flow-pill-claimed">已认领</span>
                <span class="flow-pill flow-pill-running">
                  <span class="flow-spin"></span>执行中
                </span>
                <span class="flow-pill flow-pill-waiting">等你回答</span>
                <span class="flow-pill flow-pill-done">已完成</span>
              </div>
              <ul class="flow-task-steps">
                <li class="flow-at-2 flow-tick-a">读 src/checkout/price.ts</li>
                <li class="flow-at-2 flow-tick-b">改 roundPrice，按分计算</li>
                <li class="flow-at-2 flow-tick-c">跑测试</li>
              </ul>
            </div>
          </div>

          <div class="flow-msg flow-at-3">
            <span class="flow-avatar flow-avatar-agent">
              <svg viewBox="0 0 24 24"><path d={marks.codex}></path></svg>
            </span>
            <div class="flow-ask">
              <span class="flow-ask-label">codex 在等你决定</span>
              <p>旧订单里的金额要一起重算吗？</p>
              <div class="flow-options">
                <span class="flow-option flow-option-pick">A 只修新订单</span>
                <span class="flow-option">B 一起重算</span>
              </div>
              <span class="flow-answer">你选了 A，codex 继续执行</span>
            </div>
          </div>

          <div class="flow-msg flow-at-4">
            <span class="flow-avatar flow-avatar-agent">
              <svg viewBox="0 0 24 24"><path d={marks.codex}></path></svg>
            </span>
            <div class="flow-bubble">
              <span class="flow-name">codex</span>
              <p>已修复。12 个测试通过，提交 <code>a41c9e2</code>，请 review。</p>
              <span class="flow-chips">
                <span>fix/checkout-rounding</span>
                <span>+38 −6</span>
              </span>
            </div>
          </div>

          <div class="flow-msg flow-at-5">
            <span class="flow-avatar flow-avatar-agent flow-avatar-claude">
              <svg viewBox="0 0 24 24"><path d={marks.claude}></path></svg>
            </span>
            <div class="flow-bubble">
              <span class="flow-name">claude</span>
              <p>review 通过，边界用例也覆盖了。</p>
              <span class="flow-merged">已合入 main</span>
            </div>
          </div>
        </div>
      </div>
      <div class="flow-composer">
        <span>发消息，用 @ 叫上成员…</span>
        <span class="flow-send"></span>
      </div>
    </div>
  </div>

  <figcaption>
    <span>演示动画，人名、仓库与提交均为示例。</span>
    <a href={withBase("guides/tasks/", base)}>看懂任务状态 <span aria-hidden="true">→</span></a>
  </figcaption>
</figure>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  for (const figure of document.querySelectorAll<HTMLElement>(".flow")) {
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const toggle = figure.querySelector<HTMLButtonElement>("[data-flow-toggle]");
    const toggleLabel = figure.querySelector<HTMLElement>("[data-flow-toggle-label]");
    const nowTitle = figure.querySelector<HTMLElement>("[data-flow-now-title]");
    const nowDetail = figure.querySelector<HTMLElement>("[data-flow-now-detail]");
    const last = buttons.length - 1;
    let step = last;
    let timer = 0;
    let paused = reduce.matches;
    let visible = false;

    const show = (next: number) => {
      step = next;
      figure.dataset.step = String(step);
      buttons.forEach((button, index) => {
        figure.classList.toggle(`s${index}`, index <= step);
        if (index === step) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
      });
      const current = buttons[step].querySelector(".flow-step-text");
      if (nowTitle && nowDetail && current) {
        nowTitle.textContent = current.querySelector("strong")?.textContent ?? "";
        nowDetail.textContent = current.querySelector("span")?.textContent ?? "";
      }
      figure.style.setProperty("--flow-ms", `${buttons[step].dataset.ms}ms`);
      // 重启进度条动画
      figure.classList.remove("is-ticking");
      void figure.offsetWidth;
      figure.classList.toggle("is-ticking", !paused && visible);
    };

    const schedule = () => {
      clearTimeout(timer);
      if (paused || !visible || document.hidden) return;
      timer = window.setTimeout(
        () => {
          show(step === last ? 0 : step + 1);
          schedule();
        },
        Number(buttons[step].dataset.ms) + (step === last ? 1200 : 0),
      );
    };

    const setPaused = (value: boolean) => {
      paused = value;
      figure.classList.toggle("is-paused", paused);
      if (toggle && toggleLabel) {
        toggle.setAttribute("aria-pressed", String(paused));
        toggleLabel.textContent = paused ? "播放" : "暂停";
      }
      figure.classList.toggle("is-ticking", !paused && visible);
      schedule();
    };

    buttons.forEach((button, index) =>
      button.addEventListener("click", () => {
        show(index);
        setPaused(true);
      }),
    );
    toggle?.addEventListener("click", () => {
      if (paused && step === last) show(0);
      setPaused(!paused);
    });
    if (toggle) toggle.hidden = false;

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      figure.classList.toggle("is-ticking", !paused && visible);
      schedule();
    }).observe(figure);
    document.addEventListener("visibilitychange", schedule);

    figure.classList.add("is-live");
    if (paused) setPaused(true);
    else show(0);
  }
</script>

<style>
  .flow {
    --flow-ok: #1f8a5b;
    --flow-warn: #b86e00;
    --flow-line: var(--sl-color-gray-5);
    --flow-panel: var(--sl-color-bg-sidebar);
    --flow-surface: var(--sl-color-bg);
    --flow-raised: var(--sl-color-gray-6);
    --flow-ease: cubic-bezier(0.22, 1, 0.36, 1);
    min-width: 0;
    margin: 0;
  }

  :global(:root:not([data-theme="light"])) .flow {
    --flow-ok: #4cc38a;
    --flow-warn: #f0b252;
    --flow-panel: #181818;
    --flow-surface: #1d1d1d;
    --flow-raised: #2a2a2a;
  }

  .flow-frame {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.4fr);
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--flow-line);
    border-radius: 1.25rem;
    background: var(--flow-panel);
    color: var(--sl-color-white);
    line-height: 1.5;
    text-align: left;
  }

  .flow-side {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.5rem 0.25rem 0.25rem;
  }

  .flow-kicker {
    margin: 0 0 0.9rem 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .flow-steps {
    position: relative;
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-steps li {
    margin: 0;
  }

  .flow-step {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    padding: 0.55rem 0.6rem;
    border: 0;
    border-radius: 0.7rem;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .flow-step:hover {
    background: var(--flow-raised);
  }

  .flow-step-dot {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .flow-step-text {
    display: grid;
    min-width: 0;
  }

  .flow-step-text strong {
    color: var(--sl-color-gray-2);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .flow-step-text span {
    display: block;
    overflow: hidden;
    max-height: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    opacity: 0;
  }

  .flow-step[aria-current] {
    background: var(--flow-surface);
    box-shadow: inset 0 0 0 1px var(--flow-line);
  }

  .flow-step[aria-current] .flow-step-dot {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .flow-step[aria-current] strong {
    color: var(--sl-color-white);
  }

  .flow-step[aria-current] .flow-step-text span {
    max-height: 3rem;
    margin-top: 0.15rem;
    opacity: 1;
  }

  /* 已走过的步骤打勾 */
  .flow.s1 li:nth-child(1) .flow-step:not([aria-current]) .flow-step-dot,
  .flow.s2 li:nth-child(2) .flow-step:not([aria-current]) .flow-step-dot,
  .flow.s3 li:nth-child(3) .flow-step:not([aria-current]) .flow-step-dot,
  .flow.s4 li:nth-child(4) .flow-step:not([aria-current]) .flow-step-dot,
  .flow.s5 li:nth-child(5) .flow-step:not([aria-current]) .flow-step-dot {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .flow-now {
    display: none;
  }

  .flow-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding: 1rem 0.6rem 0.25rem;
  }

  .flow-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem 0.25rem 0.45rem;
    border: 1px solid var(--flow-line);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .flow-toggle[hidden] {
    display: none;
  }

  .flow-toggle:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  .flow-toggle svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flow-icon-play,
  .flow.is-paused .flow-icon-pause {
    display: none;
  }

  .flow.is-paused .flow-icon-play {
    display: block;
    fill: currentColor;
  }

  .flow-progress {
    flex: 1;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--flow-line);
  }

  .flow-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .flow:not(.is-live) .flow-progress {
    display: none;
  }

  /* 右侧：房间窗口 */
  .flow-window {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--flow-line);
    border-radius: 0.9rem;
    background: var(--flow-surface);
    box-shadow: 0 12px 40px -24px rgb(0 0 0 / 0.35);
  }

  .flow-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--flow-line);
  }

  .flow-room {
    font-size: 0.85rem;
    font-weight: 650;
  }

  .flow-members {
    display: flex;
  }

  .flow-member {
    display: grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    margin-left: -0.3rem;
    border: 2px solid var(--flow-surface);
    border-radius: 50%;
    background: var(--flow-raised);
    color: var(--sl-color-gray-2);
    font-size: 0.62rem;
    font-weight: 600;
    transition:
      background-color 300ms ease,
      color 300ms ease;
  }

  .flow-member-agent {
    border-radius: 0.45rem;
  }

  .flow-member svg,
  .flow-avatar svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 正在干活的 Agent 在成员栏里亮起 */
  .flow[data-step="1"] .flow-member-codex,
  .flow[data-step="2"] .flow-member-codex,
  .flow[data-step="4"] .flow-member-codex,
  .flow[data-step="5"] .flow-member-claude {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .flow-feed {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 23rem;
    overflow: hidden;
    padding: 0 1rem;
    mask-image: linear-gradient(to bottom, transparent 0, #000 2.5rem);
  }

  .flow-feed-inner {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem 0;
  }

  .flow-msg {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .flow-avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--flow-raised);
    color: var(--sl-color-gray-2);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .flow-avatar-you {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .flow-avatar-agent {
    border-radius: 0.55rem;
    color: var(--sl-color-accent);
  }

  .flow-avatar-agent svg {
    width: 1rem;
    height: 1rem;
  }

  .flow-name {
    color: var(--sl-color-gray-2);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .flow-bubble,
  .flow-task,
  .flow-ask {
    min-width: 0;
    max-width: 30rem;
  }

  .flow-bubble p,
  .flow-ask p {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
  }

  .flow-bubble code {
    padding: 0.05rem 0.3rem;
    border-radius: 0.3rem;
    background: var(--flow-raised);
    font-size: 0.78rem;
  }

  .flow-mention {
    padding: 0 0.2rem;
    border-radius: 0.3rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }

  .flow-task,
  .flow-ask {
    flex: 1;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--flow-line);
    border-radius: 0.7rem;
    background: var(--flow-panel);
  }

  .flow-task-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .flow-pill {
    display: none;
    align-items: center;
    gap: 0.3rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .flow-pill-claimed,
  .flow-pill-running {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .flow-pill-waiting {
    background: color-mix(in srgb, var(--flow-warn) 16%, transparent);
    color: var(--flow-warn);
  }

  .flow-pill-done {
    background: color-mix(in srgb, var(--flow-ok) 16%, transparent);
    color: var(--flow-ok);
  }

  .flow[data-step="1"] .flow-pill-claimed,
  .flow[data-step="2"] .flow-pill-running,
  .flow[data-step="3"] .flow-pill-waiting,
  .flow.s4 .flow-pill-done {
    display: inline-flex;
  }

  .flow-spin {
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
  }

  .flow-task-steps {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow.s2 .flow-task-steps {
    margin-top: 0.45rem;
  }

  .flow-task-steps li {
    position: relative;
    margin: 0;
    padding-left: 1.2rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
  }

  .flow-task-steps li::before {
    position: absolute;
    top: 0.4em;
    left: 0.15rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--sl-color-gray-4);
    border-radius: 50%;
    content: "";
  }

  .flow.s3 .flow-task-steps li::before,
  .flow[data-step="2"] .flow-tick-a::before,
  .flow[data-step="2"] .flow-tick-b::before {
    border-color: var(--flow-ok);
    background: var(--flow-ok);
  }

  .flow-ask {
    border-color: color-mix(in srgb, var(--flow-warn) 45%, var(--flow-line));
  }

  .flow-ask-label {
    color: var(--flow-warn);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .flow-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
