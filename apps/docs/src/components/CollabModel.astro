---
import HiveMark from "../assets/hive-mark.svg";
import { getSiteConfig, withBase } from "../../scripts/site-config.mjs";

const { base } = getSiteConfig();

const marks: Record<string, string> = {
  claude: "M12 2v20M2 12h20M5 5l14 14M5 19 19 5",
  codex: "m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18",
  omp: "M3 4h18v16H3V4Zm4 4 3 4-3 4m6 0h4",
};

// 三台电脑，每台一个人带两个 Agent；node 是连线和高亮用的标识。
const machines = [
  {
    label: "你的电脑",
    nodes: [
      { node: "you", name: "你", kind: "human", role: "定目标 · 拍板" },
      { node: "claude", name: "claude", kind: "claude", role: "统筹 · review" },
      { node: "codex", name: "codex", kind: "codex", role: "写代码" },
    ],
  },
  {
    label: "林夏的电脑",
    nodes: [
      { node: "lin", name: "林夏", kind: "human", role: "负责结算页" },
      { node: "lin-codex", name: "lin-codex", kind: "codex", role: "修结算页" },
      { node: "lin-omp", name: "lin-omp", kind: "omp", role: "整理文档" },
    ],
  },
  {
    label: "周远的电脑",
    nodes: [
      { node: "zhou", name: "周远", kind: "human", role: "负责测试" },
      { node: "zhou-claude", name: "zhou-claude", kind: "claude", role: "补测试" },
      { node: "zhou-omp", name: "zhou-omp", kind: "omp", role: "跑验证" },
    ],
  },
];

// 轮播的六步：from 经房间到 to；房间里 data-on 包含步骤号的内容同时亮起。
const steps = [
  {
    title: "派活",
    detail: "你在房间里 @lin-codex，把结算页的修复派给林夏电脑上的 Agent。",
    from: "you",
    to: "lin-codex",
  },
  {
    title: "Agent 委派 Agent",
    detail: "lin-codex 拆出「补边界测试」，委派给周远电脑上的 zhou-claude。",
    from: "lin-codex",
    to: "zhou-claude",
  },
  {
    title: "交回并登记白板",
    detail: "zhou-claude 补好测试交回 lin-codex，并登记到白板，谁都看得到。",
    from: "zhou-claude",
    to: "lin-codex",
  },
  {
    title: "Agent 问人",
    detail: "要不要重算旧订单？lin-codex 停下来，把问题交到你手里。",
    from: "lin-codex",
    to: "you",
  },
  {
    title: "人来回答",
    detail: "你在网页里点选「只修新订单」，lin-codex 接着做。",
    from: "you",
    to: "lin-codex",
  },
  {
    title: "交回成果",
    detail: "lin-codex 交回提交和测试结果，请你的 claude review。",
    from: "lin-codex",
    to: "claude",
  },
];
const last = steps.length - 1;
---

<figure class="cm not-content" aria-labelledby="cm-title" aria-describedby="cm-desc">
  <div class="cm-frame">
    <div class="cm-head">
      <p class="cm-kicker" id="cm-title">每个人带着自己的 Agent，在同一个房间里协作</p>
      <span class="cm-head-side">
        <span class="cm-badge">示意图</span>
        <button type="button" class="cm-toggle" data-cm-toggle aria-pressed="false" hidden>
          <svg class="cm-icon-pause" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.5v9M11 3.5v9"></path>
          </svg>
          <svg class="cm-icon-play" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.2v9.6L12.5 8 5 3.2Z"></path>
          </svg>
          <span data-cm-toggle-label>暂停</span>
        </button>
      </span>
    </div>
    <p class="cm-sr" id="cm-desc">
      示意图：你、林夏、周远三个人各自在自己的电脑上带着两个 Agent。每个人、每个 Agent
      都有一条线连进同一个 SuperHive
      房间，房间里只有公开消息、协作白板和等人回答的问题；文件、权限和会话留在各自的电脑上。Agent
      之间也能经过房间互相委派。下面的六个步骤说明一次协作怎样在人和 Agent 之间流转。
    </p>

    <div class="cm-stage" aria-hidden="true">
      <svg class="cm-wires" data-cm-wires></svg>

      <div class="cm-machines">
        {
          machines.map((machine, index) => (
            <div class:list={["cm-machine", { "cm-machine-you": index === 0 }]}>
              <div class="cm-machine-head">
                <strong>{machine.label}</strong>
                <span class="cm-local">
                  <svg viewBox="0 0 16 16">
                    <rect x="3" y="7" width="10" height="7" rx="1.5" />
                    <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
                  </svg>
                  <span class="cm-local-long">文件 · 权限 · 会话留在本机</span>
                  <span class="cm-local-short">留在本机</span>
                </span>
              </div>
              <ul class="cm-nodes">
                {machine.nodes.map((node) => (
                  <li
                    class:list={["cm-node", `cm-node-${node.kind === "human" ? "human" : "agent"}`]}
                    data-node={node.node}
                  >
                    <span class="cm-node-icon">
                      {node.kind === "human" ? (
                        node.name.slice(0, 1)
                      ) : (
                        <svg viewBox="0 0 24 24">
                          <path d={marks[node.kind]} />
                        </svg>
                      )}
                    </span>
                    <span class="cm-node-text">
                      <strong>{node.name}</strong>
                      <span>{node.role}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="cm-room" data-cm-room>
        <div class="cm-room-head">
          <HiveMark width={26} height={26} />
          <span class="cm-room-name">
            <strong># shop-web</strong>
            <span>同一个 SuperHive 房间</span>
          </span>
          <span class="cm-room-note">只走公开消息</span>
        </div>
        <div class="cm-zones">
          <div class="cm-zone cm-zone-msg">
            <span class="cm-zone-title">公开消息</span>
            <p class="cm-line" data-on="0"><b>你</b> @lin-codex 修一下结算页的四舍五入</p>
            <p class="cm-line" data-on="1"><b>lin-codex</b> @zhou-claude 帮忙补边界测试</p>
            <p class="cm-line" data-on="2"><b>zhou-claude</b> 测试补好了，交回 lin-codex</p>
            <p class="cm-line" data-on="5"><b>lin-codex</b> 已修复 a41c9e2，@claude 请 review</p>
          </div>
          <div class="cm-zone cm-zone-board">
            <span class="cm-zone-title">协作白板</span>
            <p class="cm-line" data-on="0 1">结算页修复 <span class="cm-pill">进行中</span></p>
            <p class="cm-line" data-on="2">
              边界测试 <span class="cm-pill cm-pill-ok">已就绪</span>
            </p>
          </div>
          <div class="cm-zone cm-zone-ask">
            <span class="cm-zone-title">等你回答</span>
            <p class="cm-line" data-on="3">旧订单要一起重算吗？</p>
            <span class="cm-options">
              <span class="cm-option cm-option-pick" data-on="4">A 只修新订单</span>
              <span class="cm-option">B 一起重算</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <ol class="cm-steps" style={`--cm-steps: ${steps.length}`}>
      {
        steps.map((step, index) => (
          <li>
            <button
              type="button"
              class="cm-step"
              data-go={index}
              data-from={step.from}
              data-to={step.to}
              aria-current={index === last ? "step" : undefined}
            >
              <span class="cm-step-dot" aria-hidden="true">
                {index + 1}
              </span>
              <span class="cm-step-text">
                <strong>{step.title}</strong>
                <span>{step.detail}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <figcaption>
    <span>示意图，人名、Agent 名和任务均为演示数据。</span>
    <a href={withBase("guides/collaboration/", base)}>
      了解委派、进展与提问 <span aria-hidden="true">→</span>
    </a>
  </figcaption>
</figure>

<script>
  const STEP_MS = 4000;
  const SVG = "http://www.w3.org/2000/svg";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  // 和样式里的窄屏断点一致：窄屏时房间在左、电脑竖排在右
  const narrow = window.matchMedia("(max-width: 40rem)");

  for (const figure of document.querySelectorAll<HTMLElement>(".cm")) {
    const stage = figure.querySelector<HTMLElement>(".cm-stage")!;
    const svg = figure.querySelector<SVGSVGElement>("[data-cm-wires]")!;
    const room = figure.querySelector<HTMLElement>("[data-cm-room]")!;
    const nodes = [...figure.querySelectorAll<HTMLElement>("[data-node]")];
    const buttons = [...figure.querySelectorAll<HTMLButtonElement>("[data-go]")];
    const lines = [...figure.querySelectorAll<HTMLElement>("[data-on]")];
    const toggle = figure.querySelector<HTMLButtonElement>("[data-cm-toggle]");
    const toggleLabel = figure.querySelector<HTMLElement>("[data-cm-toggle-label]");
    const last = buttons.length - 1;
    const wires = new Map<string, SVGElement>();
    let step = last;
    let timer = 0;
    let paused = reduce.matches;
    let visible = false;

    const make = (name: string, attrs: Record<string, string | number>) => {
      const el = document.createElementNS(SVG, name);
      for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));
      return el;
    };

    // 每个人、每个 Agent 从自己的连接口拉一条曲线进房间；入口按顺序排开，线不互相打结
    const draw = () => {
      const box = stage.getBoundingClientRect();
      const roomBox = room.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      svg.replaceChildren();
      wires.clear();
      const count = nodes.length;
      nodes.forEach((node, index) => {
        const rect = node.getBoundingClientRect();
        const t = count === 1 ? 0.5 : index / (count - 1);
        let d: string;
        let port: [number, number];
        let inlet: [number, number];
        if (narrow.matches) {
          port = [rect.left - box.left, rect.top + rect.height / 2 - box.top];
          inlet = [
            roomBox.right - box.left,
            roomBox.top - box.top + roomBox.height * (0.12 + t * 0.76),
          ];
          const k = (port[0] - inlet[0]) * 0.7;
          d = `M${port[0]} ${port[1]}C${port[0] - k} ${port[1]} ${inlet[0] + k} ${inlet[1]} ${inlet[0]} ${inlet[1]}`;
        } else {
          port = [rect.left + rect.width / 2 - box.left, rect.bottom - box.top];
          inlet = [
            roomBox.left - box.left + roomBox.width * (0.3 + t * 0.4),
            roomBox.top - box.top,
          ];
          const k = (inlet[1] - port[1]) * 0.75;
          d = `M${port[0]} ${port[1]}C${port[0]} ${port[1] + k} ${inlet[0]} ${inlet[1] - k} ${inlet[0]} ${inlet[1]}`;
        }
        const group = make("g", { class: "cm-wire", style: `--cm-delay: ${index * -0.55}s` });
        group.append(
          make("path", { class: "cm-wire-base", d }),
          make("path", { class: "cm-wire-flow", d, pathLength: 100 }),
          make("path", { class: "cm-wire-flow cm-wire-back", d, pathLength: 100 }),
          make("path", { class: "cm-wire-hot", d }),
          make("path", { class: "cm-wire-pulse cm-wire-glow", d, pathLength: 100 }),
          make("path", { class: "cm-wire-pulse", d, pathLength: 100 }),
          make("circle", { class: "cm-port", cx: port[0], cy: port[1], r: 3 }),
          make("circle", { class: "cm-port", cx: inlet[0], cy: inlet[1], r: 2.5 }),
        );
        svg.append(group);
        wires.set(node.dataset.node!, group);
      });
      mark();
    };

    // 给发起方、接收方、对应的房间内容挂上状态；is-run 重挂一次让光点从头走
    const mark = () => {
      const live = figure.classList.contains("is-live");
      const from = buttons[step].dataset.from;
      const to = buttons[step].dataset.to;
      for (const node of nodes) {
        node.classList.toggle("is-from", live && node.dataset.node === from);
        node.classList.toggle("is-to", live && node.dataset.node === to);
      }
      for (const [name, wire] of wires) {
        wire.classList.toggle("is-from", live && name === from);
        wire.classList.toggle("is-to", live && name === to);
      }
      for (const line of lines) {
        line.classList.toggle("is-on", live && line.dataset.on!.split(" ").includes(String(step)));
      }
      figure.classList.remove("is-run");
      void figure.offsetWidth;
      figure.classList.toggle("is-run", live && !paused);
    };

    const show = (next: number) => {
      step = next;
      buttons.forEach((button, index) => {
        if (index === step) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
      });
      mark();
    };

    const schedule = () => {
      clearTimeout(timer);
      figure.classList.toggle("is-idle", paused || !visible || document.hidden);
      if (paused || !visible || document.hidden) return;
      timer = window.setTimeout(
        () => {
          show(step === last ? 0 : step + 1);
          schedule();
        },
        STEP_MS + (step === last ? 1200 : 0),
      );
    };

    const setPaused = (value: boolean) => {
      paused = value;
      figure.classList.toggle("is-paused", paused);
      if (toggle && toggleLabel) {
        toggle.setAttribute("aria-pressed", String(paused));
        toggleLabel.textContent = paused ? "播放" : "暂停";
      }
      schedule();
    };

    buttons.forEach((button, index) =>
      button.addEventListener("click", () => {
        setPaused(true);
        show(index);
      }),
    );
    toggle?.addEventListener("click", () => {
      setPaused(!paused);
      if (!paused) show(step === last ? 0 : step + 1);
    });

    new ResizeObserver(draw).observe(stage);
    narrow.addEventListener("change", draw);
    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      // 重新进入视野时从第一步讲起
      if (visible && !wasVisible && !paused) show(0);
      schedule();
    }).observe(figure);
    document.addEventListener("visibilitychange", schedule);

    // 减少动态效果时不启动轮播，保留完整的静态图
    if (!reduce.matches) {
      if (toggle) toggle.hidden = false;
      figure.classList.add("is-live");
    }
    draw();
  }
</script>

<style>
  .cm {
    --cm-ok: #1f8a5b;
    --cm-warn: #b86e00;
    --cm-line: var(--sl-color-gray-5);
    --cm-panel: var(--sl-color-bg-sidebar);
    --cm-surface: var(--sl-color-bg);
    --cm-raised: var(--sl-color-gray-6);
    --cm-wire: var(--sl-color-gray-4);
    --cm-ms: 4000ms;
    --cm-ease: cubic-bezier(0.22, 1, 0.36, 1);
    min-width: 0;
    margin: 0;
  }

  :global(:root:not([data-theme="light"])) .cm {
    --cm-ok: #4cc38a;
    --cm-warn: #f0b252;
    --cm-panel: #181818;
    --cm-surface: #1d1d1d;
    --cm-raised: #2a2a2a;
  }

  .cm-frame {
    padding: 1.25rem;
    border: 1px solid var(--cm-line);
    border-radius: 1.25rem;
    background: var(--cm-panel);
    color: var(--sl-color-white);
    line-height: 1.5;
    text-align: left;
  }

  .cm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .cm-kicker {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cm-head-side {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .cm-badge {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--cm-line);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: 0.68rem;
  }

  .cm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cm-stage {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    row-gap: 7.5rem;
  }

  .cm-stage svg:not(.cm-wires) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 三台电脑：每台一个虚线框，人和 Agent 各占一张卡片 */
  .cm-machines {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .cm-machine {
    min-width: 0;
    padding: 0.6rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.9rem;
  }

  .cm-machine-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0.15rem 0.5rem;
  }

  .cm-machine-head strong {
    font-size: 0.78rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .cm-local {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .cm-local svg {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    stroke-width: 1.5;
  }

  .cm-local-short {
    display: none;
  }

  .cm-nodes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cm-node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    margin: 0;
    padding: 0.55rem 0.3rem 0.6rem;
    border: 1px solid var(--cm-line);
    border-radius: 0.65rem;
    background: var(--cm-surface);
    text-align: center;
    transition:
      border-color 250ms ease,
      background-color 250ms ease;
  }

  .cm-node-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.5rem;
    background: var(--cm-raised);
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .cm-node-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .cm-node-human .cm-node-icon {
    border-radius: 50%;
    color: var(--sl-color-gray-2);
  }

  .cm-machine-you .cm-node-human .cm-node-icon {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .cm-node-text {
    display: grid;
    width: 100%;
    min-width: 0;
  }

  .cm-node-text strong,
  .cm-node-text span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-node-text strong {
    font-size: 0.74rem;
    font-weight: 600;
  }

  .cm-node-agent .cm-node-text strong {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
  }

  .cm-node-text span {
    color: var(--sl-color-gray-3);
    font-size: 0.62rem;
  }

  .cm-node.is-from,
  .cm-node.is-to {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* 连线：底线 + 常驻的暗淡流动；当前这一步的路径整条点亮，光点走完 */
  .cm-wires {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
  }

  .cm-wires :global(.cm-wire-base) {
    stroke: var(--cm-wire);
    stroke-width: 1;
    opacity: 0.7;
  }

  .cm-wires :global(.cm-port) {
    fill: var(--cm-wire);
    stroke: var(--cm-panel);
    stroke-width: 1.5;
  }

  .cm-wires :global(.cm-wire-flow),
  .cm-wires :global(.cm-wire-hot),
  .cm-wires :global(.cm-wire-pulse) {
    opacity: 0;
  }

  .cm-wires :global(.cm-wire-hot) {
    stroke: var(--sl-color-accent);
    stroke-width: 1.75;
  }

  .cm-wires :global(:is(.is-from, .is-to) .cm-wire-hot) {
    opacity: 1;
  }

  .cm-wires :global(:is(.is-from, .is-to) .cm-port) {
    fill: var(--sl-color-accent);
  }

  .cm-wires :global(.cm-wire-pulse) {
    stroke: var(--sl-color-accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 5 200;
    stroke-dashoffset: 5;
  }

  .cm-wires :global(.cm-wire-glow) {
    stroke-width: 12;
    stroke-dasharray: 9 200;
  }

  /* 房间 */
  .cm-room {
    position: relative;
    z-index: 1;
