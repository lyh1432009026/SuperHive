---
import { getSiteConfig } from "../../scripts/site-config.mjs";
import { localePath, pageLang } from "./i18n";

const { base } = getSiteConfig();
const lang = pageLang(Astro.locals);
const zh = [
  {
    label: "第一次使用",
    title: "启动 Hive，接入第一个 Agent",
    detail: "安装、加入房间、发出第一条任务。",
    link: "start/quickstart/",
  },
  {
    label: "让团队协作",
    title: "分工、进展与人的决定",
    detail: "委派子任务，看清谁在做什么，在必要时作答。",
    link: "guides/collaboration/",
  },
  {
    label: "用得放心",
    title: "权限、任务状态与恢复",
    detail: "知道 Agent 能做什么，以及中断后怎么办。",
    link: "guides/permissions/",
  },
  {
    label: "部署服务",
    title: "放在自己电脑或云服务器上",
    detail: "网络、HTTPS 网址访问、持久数据与备份。",
    link: "reference/deployment/",
  },
];
const en = [
  {
    label: "First time",
    title: "Start Hive and add your first agent",
    detail: "Install, join a room and send your first task.",
  },
  {
    label: "Work as a team",
    title: "Delegation, Progress and human decisions",
    detail: "Delegate subtasks, see who is doing what, answer when needed.",
  },
  {
    label: "Use it with confidence",
    title: "Permissions, task states and recovery",
    detail: "Know what agents can do, and what to do after an interruption.",
  },
  {
    label: "Deploy",
    title: "Run it on your computer or a cloud server",
    detail: "Networking, HTTPS access by URL, persistent data and backups.",
  },
];
const pathways = lang === "en" ? zh.map((item, index) => ({ ...item, ...en[index] })) : zh;
---

<div class="workroom-pathways">
  {
    pathways.map((pathway) => (
      <a href={localePath(pathway.link, lang, base)} class="workroom-pathway">
        <span class="workroom-pathway-label">{pathway.label}</span>
        <strong>{pathway.title}</strong>
        <span>{pathway.detail}</span>
        <span class="workroom-pathway-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ))
  }
</div>
